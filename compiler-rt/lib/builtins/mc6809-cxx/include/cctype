#ifndef _MC6809_CXX_CCTYPE
#define _MC6809_CXX_CCTYPE

// cctype -- the C library's ctype.h under C++ rules.
//
// There is no C++ standard library on this target; these headers exist so
// that ordinary C++ can use the C library by its standard spelling.  They
// declare nothing of their own: the names are picolibc's, brought into
// namespace std as the standard says they should be.

#include <ctype.h>

namespace std {
using ::isalnum;
using ::isalpha;
using ::isblank;
using ::iscntrl;
using ::isdigit;
using ::isgraph;
using ::islower;
using ::isprint;
using ::ispunct;
using ::isspace;
using ::isupper;
using ::isxdigit;
using ::tolower;
using ::toupper;
} // namespace std

#endif
