#ifndef _MC6809_CXX_CSTDINT
#define _MC6809_CXX_CSTDINT

// cstdint -- the C library's stdint.h under C++ rules.
//
// There is no C++ standard library on this target; these headers exist so
// that ordinary C++ can use the C library by its standard spelling.  They
// declare nothing of their own: the names are picolibc's, brought into
// namespace std as the standard says they should be.

#include <stdint.h>

namespace std {
using ::int8_t;
using ::int16_t;
using ::int32_t;
using ::int64_t;
using ::uint8_t;
using ::uint16_t;
using ::uint32_t;
using ::uint64_t;
using ::intptr_t;
using ::uintptr_t;
using ::intmax_t;
using ::uintmax_t;
using ::int_least8_t;
using ::int_least16_t;
using ::int_least32_t;
using ::uint_least8_t;
using ::uint_least16_t;
using ::uint_least32_t;
using ::int_fast8_t;
using ::int_fast16_t;
using ::int_fast32_t;
using ::uint_fast8_t;
using ::uint_fast16_t;
using ::uint_fast32_t;
} // namespace std

#endif
