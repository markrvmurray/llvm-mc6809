# Bug #163 Phase 2: end-to-end CRT0 test.
#
# Builds crt0.S + a minimal user main(), links with mc6809-os9.lds,
# wraps with os9-link, validates with os9-module-check.  The whole
# Phase 2 pipeline runs in this one test (assembler → linker →
# wrapper → validator).
#
# User stub:  main: ldb #42; rts        // return 42 as exit status
#
# Body layout (no .data, no .bss → CRT collapses the copy and zero loops
# via the BEQ-on-zero guards):
#   _start (in .text.startup) → jsr main → swi2 → fcb $06
#   main   (in .text)         → ldb #42; rts
#
# We don't byte-pin the entire body (encoding details may shift), but
# we DO pin three things:
#   1. _start MUST be at body offset 0 (so M$Exec = 13).
#      Asserted by checking the first 3 bytes are `cc 00 18`
#      (LDD #__dp_data_start: the direct-page data follows the $18
#      bytes of imaginary registers at the start of the data area).
#   2. Body must contain the F$Exit syscall sequence `10 3f 06`.
#   3. os9-module-check accepts the wrapped module.

# Assemble a stub main().
RUN: echo '        .text'              >  %t-main.s
RUN: echo '        .globl main'        >> %t-main.s
RUN: echo 'main:'                      >> %t-main.s
RUN: echo '        ldb #42'            >> %t-main.s
RUN: echo '        rts'                >> %t-main.s

RUN: llvm-mc -triple=mc6809-unknown-os9 --filetype=obj \
RUN:   %S/../../../../compiler-rt/lib/builtins/mc6809-os9/crt0.S -o %t-crt0.o
RUN: llvm-mc -triple=mc6809-unknown-os9 --filetype=obj %t-main.s -o %t-main.o

# The C half of start-up (crt1.c: heap claim, argv, main, F$Exit) stands in
# as an assembly stub here -- this test is about crt0.S and the module wrap.
RUN: echo '        .text'                               >  %t-crt1.s
RUN: echo '        .globl __os9_crt1'                   >> %t-crt1.s
RUN: echo '__os9_crt1:'                                 >> %t-crt1.s
RUN: echo '        lbsr main'                           >> %t-crt1.s
RUN: echo '        tfr x,d'                             >> %t-crt1.s
RUN: echo '        os9 0x06'                            >> %t-crt1.s
RUN: echo '        .bss'                                >> %t-crt1.s
RUN: echo '        .globl __os9_data_base, __os9_param, __os9_param_len, __os9_top' >> %t-crt1.s
RUN: echo '        .globl __os9_module, __os9_mem_want, __os9_pool_off, __os9_pool_len, __os9_stack_size' >> %t-crt1.s
RUN: echo '__os9_data_base: .zero 2'                    >> %t-crt1.s
RUN: echo '__os9_param: .zero 2'                        >> %t-crt1.s
RUN: echo '__os9_param_len: .zero 2'                    >> %t-crt1.s
RUN: echo '__os9_top: .zero 2'                          >> %t-crt1.s
RUN: echo '__os9_module: .zero 2'                       >> %t-crt1.s
RUN: echo '__os9_mem_want: .zero 2'                     >> %t-crt1.s
RUN: echo '__os9_pool_off: .zero 2'                     >> %t-crt1.s
RUN: echo '__os9_pool_len: .zero 2'                     >> %t-crt1.s
RUN: echo '__os9_stack_size: .zero 2'                   >> %t-crt1.s
RUN: llvm-mc -triple=mc6809-unknown-os9 --filetype=obj %t-crt1.s -o %t-crt1.o

RUN: ld.lld -T %S/../../../../compiler-rt/lib/builtins/mc6809-os9/mc6809-os9.lds \
RUN:   --oformat=binary \
RUN:   %t-crt0.o %t-crt1.o %t-main.o -o %t.body

# Flatten the body to one continuous hex line via xxd (-w on od is
# GNU-only; xxd is portable across macOS and Linux distros).
RUN: xxd -p -c 256 %t.body > %t.body.hex

# 1. _start at offset 0 — first instructions keep the parameter string, its length and the top
#    (PSHS D,X,Y: 34 36) and load #__dp_data_start (=$18): cc 00 18.
#    Anchored to start of line.
RUN: FileCheck %s --check-prefix=PROLOGUE < %t.body.hex
PROLOGUE: {{^3436cc0018}}

# 2. Body must contain the F$Exit syscall sequence (10 3f 06).
RUN: FileCheck %s --check-prefix=EXITSEQ < %t.body.hex
EXITSEQ: 103f06

# 3. Wrap and validate.  Use --mem 1024 (data 0 + bss 0 + heap 1024 +
#    stack 0 in a stripped-down test; reality is __mem_size symbol-fed,
#    but for the test the value doesn't have to match a real allocation).
RUN: %S/../../../../tools/os9-link %t.body --name crt0test --exec 13 --mem 1024 -o %t.os9
RUN: %S/../../../../tools/os9-module-check %t.os9 | FileCheck %s --check-prefix=VALID

VALID: OK ({{[0-9]+}} bytes)
VALID: exec offset: $000D (13)
VALID: name: "crt0test"
VALID: CRC: valid (full CRC = $800FE3)
