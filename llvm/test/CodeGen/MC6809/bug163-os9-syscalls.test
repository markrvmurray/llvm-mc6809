# Bug #163 Phase 2: assembler-level test for the OS-9 syscall stubs.
#
# Verifies that each syscall stub emits the expected SWI2 + FCB pair
# AND consumes its C-ABI args (X = first int/ptr arg; 2,s = second;
# 4,s = third) into the OS-9 entry registers (A = path#, X = buf,
# Y = nbytes).  Any future refactor that drops a TFR or reorders the
# LDX/LDY pair will fail loudly.
#
# Locked-in byte patterns per syscall:
#
#   _exit:  moved to the inline-asm C source syscalls.c; its SWI2 + FCB
#           F$Exit ($06) codegen is covered by os9-exit.ll (llc).
#
#   _write: contains `1f 10 1f 98 ae 62 10 ae 64 10 3f 8a 25`
#           (tfr x,d ; tfr b,a ; ldx 2,s ; ldy 4,s ; swi2 ;
#            FCB I$Write=$8A ; BCS +N)
#
#   _read:  contains `1f 10 1f 98 ae 62 10 ae 64 10 3f 89 25`
#           (same as _write but FCB I$Read=$89)
#
# The 25 byte after the FCB is the BCS opcode for the error-branch.
# The error path itself (ldx #-1 ; rts = 8e ff ff 39) is shared, so
# no need to lock its bytes per syscall.

RUN: llvm-mc -triple=mc6809 --filetype=obj \
RUN:   %S/../../../../compiler-rt/lib/builtins/mc6809-os9/syscalls.S \
RUN:   -o %t.o

# Hex-dump the .text section's bytes via llvm-objcopy → raw + xxd.
# (llvm-objdump's disassembly view confuses the data FCB bytes with
# instructions; we want the raw bytes.)
RUN: llvm-objcopy -O binary --only-section=.text %t.o %t.text.bin
RUN: xxd -p -c 256 %t.text.bin > %t.text.hex

# _write body: tfr x,d ; tfr b,a ; ldx 2,s ; ldy 4,s ; swi2 ; I$Write
RUN: FileCheck %s --check-prefix=WRITE < %t.text.hex
WRITE: 1f101f98ae6210ae64103f8a25

# _read body: same shape, FCB = I$Read ($89)
RUN: FileCheck %s --check-prefix=READ < %t.text.hex
READ: 1f101f98ae6210ae64103f8925
