; CHECK-NEXT:    ldb #0
; CHECK-NEXT:    bra .LBB0_3
; CHECK-NEXT:  .LBB0_2: ; %entry
; CHECK-NEXT:    ldb #1
; CHECK-NEXT:  .LBB0_3: ; %entry
; CHECK-NEXT:    lda #0
; CHECK-NEXT:    sta 19,s ; 1-byte Folded Spill
; CHECK-NEXT:    lda #0
; CHECK-NEXT:    tfr d,d
; CHECK-NEXT:    ldb d,x
; CHECK-NEXT:    ldx #0
; CHECK-NEXT:    stx <__rs0
; CHECK-NEXT:    subb #48
; CHECK-NEXT:    stb 18,s ; 1-byte Folded Spill
; CHECK-NEXT:    ldb #0
; CHECK-NEXT:    sbcb #0
; CHECK-NEXT:    stb 17,s ; 1-byte Folded Spill
; CHECK-NEXT:    ldb <__rs0lo
; CHECK-NEXT:    lda <__rs0hi
; CHECK-NEXT:    sbcb #0
; CHECK-NEXT:    sbca #0
; CHECK-NEXT:    pshs d
