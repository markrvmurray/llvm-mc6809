entry:
  %first = load i8, ptr %s, align 1
  %is_neg = icmp eq i8 %first, 45
  %offset = zext i1 %is_neg to i16
  %digit_ptr = getelementptr inbounds i8, ptr %s, i16 %offset
  %d8 = load i8, ptr %digit_ptr, align 1
  %d32 = zext i8 %d8 to i32
  %sub_off = sub nuw nsw i32 %d32, 48
  br label %loop
loop:
  %acc = phi i32 [ %sub_off, %entry ], [ %nextsum, %loop ]
  %i = phi i8 [ 0, %entry ], [ %inext, %loop ]
  %mul = mul nsw i32 %acc, 10
  %nextsum = add nsw i32 %mul, %sub_off
  %inext = add i8 %i, 1
  %done = icmp eq i8 %inext, 2
  br i1 %done, label %exit, label %loop
exit:
  %neg = sub nsw i32 0, %acc
  %cond = select i1 %is_neg, i32 %neg, i32 %acc
  store i32 %cond, ptr %out, align 1
  ret void
