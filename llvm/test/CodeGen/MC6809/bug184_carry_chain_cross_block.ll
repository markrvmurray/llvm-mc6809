; CHECK-NEXT:    std <__rs1
; CHECK-NEXT:    bra .LBB0_4
; CHECK-NEXT:  .LBB0_4: ; %loop
; CHECK-NEXT:    ; =>This Inner Loop Header: Depth=1
; CHECK-NEXT:    leay 21,s
; CHECK-NEXT:    pshs d
; CHECK-NEXT:    ldd <__rs0
; CHECK-NEXT:    std 10,s ; 2-byte Folded Spill
