# RUN: llc -global-isel -mtriple=mc6809 -mcpu=hd6309 -run-pass=mc6809-sanitise-debug-info -o - %s | FileCheck %s
#
# Bug #243: MC6809SanitiseDebugInfo erases DBG_VALUEs whose DIExpression
# contains DW_OP_LLVM_fragment. The legalizer's narrowScalar emits these
# when splitting a wide producer (G_ABS s64, G_MERGE_VALUES s64) that had
# a surviving DBG_VALUE — they are valid at legalize time but later trip
# LiveDebugVariables's `cast<DIExpression>(Expr)->isValid()` assert in
# VirtRegRewriter. Stripping them post-isel removes the upstream gap.
#
# CHECK-LABEL: name: bug243_strip_fragment_dbg_value
# CHECK: bb.0:
# CHECK-NOT: DBG_VALUE {{.*}}DW_OP_LLVM_fragment
# CHECK-NOT: !DIExpression(4096
# CHECK: $aa = COPY %0
# CHECK: ReturnImplicit
--- |
  define void @bug243_strip_fragment_dbg_value() !dbg !4 {
    ret void, !dbg !9
  }

  !llvm.dbg.cu = !{!0}
  !llvm.module.flags = !{!2, !3}

  !0 = distinct !DICompileUnit(language: DW_LANG_C99, file: !1, producer: "clang", isOptimized: true, runtimeVersion: 0, emissionKind: FullDebug)
  !1 = !DIFile(filename: "bug243.c", directory: "/")
  !2 = !{i32 7, !"Dwarf Version", i32 4}
  !3 = !{i32 2, !"Debug Info Version", i32 3}
  !4 = distinct !DISubprogram(name: "bug243_strip_fragment_dbg_value", scope: !1, file: !1, line: 1, type: !5, scopeLine: 1, spFlags: DISPFlagDefinition, unit: !0)
  !5 = !DISubroutineType(types: !6)
  !6 = !{null}
  !7 = !DILocalVariable(name: "j", scope: !4, file: !1, type: !8)
  !8 = !DIBasicType(name: "long long", size: 64, encoding: DW_ATE_signed)
  !9 = !DILocation(line: 1, column: 1, scope: !4)
...
---
name: bug243_strip_fragment_dbg_value
tracksRegLiveness: true
body: |
  bb.0:
    %0:_(s8) = G_CONSTANT i8 0
    DBG_VALUE %0(s8), $noreg, !7, !DIExpression(DW_OP_LLVM_fragment, 0, 32), debug-location !9
    DBG_VALUE %0(s8), $noreg, !7, !DIExpression(DW_OP_LLVM_fragment, 32, 32), debug-location !9
    $aa = COPY %0(s8)
    ReturnImplicit implicit $aa
...
