# RUN: llc -mtriple=mc6809 -mcpu=hd6309 -run-pass=postrapseudos \
# RUN:     %s -o - | FileCheck %s
#
# Regression sentinel for bug #257 — Compare_i8_Reg with same-half
# spill+physreg collision must emit PULS to restore Src1Phys, NOT
# LEAS, otherwise successor BBs that have Src1Phys as a livein read
# the wrong value.
#
# History: memcmp.c at -O2 HD6309 byte-loop tail miscompile. The
# expansion of Compare_i8_Reg in `expandCompareReg` case (i) used
# `PSHS Src1Phys; LDB spill,$su; CMPB ,$ss; LEAS 1,$ss`. The
# materializeReg(Src2) clobbers Src1Phys with Src2's spill value;
# LEAS pops the stack but leaves Src1Phys holding the wrong value.
# The mismatch-side successor BB that expected Src1Phys to still
# hold its pre-Compare value (e.g., the byte difference computation
# `*s1 - *s2` in memcmp's byte loop) computed the wrong result.
#
# Fix: replace LEAS with PULS Src1Phys so the original value is
# restored from the stack. CC flags from CMPB are preserved across
# PULS. Cycle cost: +1 cy (PULS B) or +2 cy (PULS D) over LEAS.
#
# Bench impact: test-getopt at O2/O2-fp/Og-hd6309-mame returned to
# PASS (was FAIL); cycles dropped 1.5M → 0.75M (because the failing
# version was traversing extra error paths).

# CHECK-LABEL: name: compare_i8_reg_spill_physreg_collision
# After expansion, the spill+physreg collision path should emit
# PSHS B; LDB spill,$su; CMPB 0,$ss; PULS B
# (NOT PSHS B; LDB spill,$su; CMPB 0,$ss; LEAS 1,$ss).
# CHECK:      PSHSs $ab
# CHECK:      LDB
# CHECK:      CMPB
# CHECK:      $ab = PULSs
# CHECK-NOT:  LEASi_o5 1, $ss
---
name: compare_i8_reg_spill_physreg_collision
tracksRegLiveness: true
frameInfo:
  hasCalls: false
stack:
  - { id: 0, name: '', size: 2, alignment: 1 }
body: |
  bb.0:
    liveins: $ab, $spill_b1, $su
    $cc = Compare_i8_Reg 7, renamable $spill_b1, renamable $ab, implicit-def dead $nz, implicit-def dead $v, implicit-def dead $c
    RTSr implicit $ab
...
