# RUN: llc -global-isel -global-isel-abort=1 -mtriple=mc6809 -run-pass=instruction-select -verify-machineinstrs -o - %s | FileCheck %s

# Bug #311: instruction-select must handle `G_CONSTANT s1` directly.
#
# The legalizer normally widens `G_CONSTANT i1 → G_CONSTANT i8` before
# selection runs, so a standalone llc pipeline never sees a bare
# `G_CONSTANT s1` at selection time.  But LLD's LTO codegen pipeline
# does NOT run that widening combiner pass; bare `G_CONSTANT s1`
# reaches the selector intact at LTO link time.
#
# Pre-fix, selection failed with:
#   LLVM ERROR: cannot select: %N:accum(s1) = G_CONSTANT i1 false
# breaking every LTO target in the picolibc bench (O2-lto, O3-lto,
# Os-lto, Os-lto-fp, Og-lto-hd6309-mame-fp, Os-lto-hd6309-mame,
# Os-lto-hd6309-mame-fp).
#
# Fix: a C++ intercept in MC6809InstructionSelector lowers
# `G_CONSTANT s1` to `Load_i8_Imm` with the LSB masked.  Result class
# is ACC8 (the byte's LSB carries the boolean — the same encoding
# BIT1 used pre-elimination).

---
name: const_s1_false
legalized: true
regBankSelected: true
tracksRegLiveness: true
body: |
  bb.0:
    ; CHECK-LABEL: name: const_s1_false
    ; CHECK: %0:acc8 = Load_i8_Imm 0
    %0:accum(s1) = G_CONSTANT i1 false
    ReturnImplicit implicit %0(s1)
...

---
name: const_s1_true
legalized: true
regBankSelected: true
tracksRegLiveness: true
body: |
  bb.0:
    ; CHECK-LABEL: name: const_s1_true
    ; CHECK: %0:acc8 = Load_i8_Imm 1
    %0:accum(s1) = G_CONSTANT i1 true
    ReturnImplicit implicit %0(s1)
...
