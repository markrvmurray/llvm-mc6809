# RUN: llc -mtriple=mc6809 -run-pass=mc6809-late-opt -o - %s | FileCheck %s

# Bug #361: fold an index-LEA into the register-indirect load that immediately
# dereferences it (`leaR <addr>; ld<V> ,R -> ld<V> <addr>`). dst == base (the
# load reloads into the index register the LEA computed) is unconditionally safe.
# dst != base (the base survives the load) is folded ONLY when that base register
# is dead after the load (a `killed` use, or a dead liveness result).

# dst == base, constant offset, base register (U) differs from the index
# register (X): `leax 12,u; ldx ,x -> ldx 12,u`. The folded load's base must come
# from the LEA's input (U), not the index register (X).
# CHECK-LABEL: name: fold_dst_eq_base
# CHECK:      LDXi_o8 12, $su
# CHECK-NOT:  LEAXi_o8
# CHECK-NOT:  LDXi_o0
---
name: fold_dst_eq_base
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $su
    LEAXi_o8 12, $su, implicit-def renamable $ix, implicit-def $z
    LDXi_o0 killed renamable $ix, implicit-def renamable $ix, implicit-def $nz, implicit-def $n, implicit-def $z, implicit-def $v
    RTSr implicit $ix
...

# dst != base with the base DEAD after the load (X is killed by the load and not
# used again): `leax 12,u; ldy ,x -> ldy 12,u`. Safe — the base X's discarded
# advance is never observed.
# CHECK-LABEL: name: fold_dst_ne_base_dead
# CHECK:      LDYi_o8 12, $su
# CHECK-NOT:  LEAXi_o8
# CHECK-NOT:  LDYi_o0
---
name: fold_dst_ne_base_dead
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $su
    LEAXi_o8 12, $su, implicit-def renamable $ix, implicit-def $z
    LDYi_o0 killed renamable $ix, implicit-def renamable $iy, implicit-def $nz, implicit-def $n, implicit-def $z, implicit-def $v
    RTSr implicit $iy
...

# Negative: dst != base with the base LIVE after the load (the walking-pointer
# counter-example — X is advanced by the LEA and still needed afterwards). Must
# NOT fold: folding would drop X's advance.
# CHECK-LABEL: name: no_fold_dst_ne_base_live
# CHECK:      LEAXi_o8 12, $su
# CHECK:      LDYi_o0 renamable $ix
---
name: no_fold_dst_ne_base_live
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $su
    LEAXi_o8 12, $su, implicit-def renamable $ix, implicit-def $z
    LDYi_o0 renamable $ix, implicit-def renamable $iy, implicit-def $nz, implicit-def $n, implicit-def $z, implicit-def $v
    RTSr implicit $ix, implicit $iy
...

# Negative: a non-adjacent load must NOT fold — an intervening instruction breaks
# the LEA/load adjacency the fold requires.
# CHECK-LABEL: name: no_fold_non_adjacent
# CHECK:      LEAXi_o8 12, $su
# CHECK:      LDAi_o8 43, $su
# CHECK:      LDXi_o0 killed renamable $ix
---
name: no_fold_non_adjacent
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $su
    LEAXi_o8 12, $su, implicit-def renamable $ix, implicit-def $z
    LDAi_o8 43, $su, implicit-def $aa, implicit-def $nz, implicit-def $n, implicit-def $z, implicit-def $v
    LDXi_o0 killed renamable $ix, implicit-def renamable $ix, implicit-def $nz, implicit-def $n, implicit-def $z, implicit-def $v
    RTSr implicit $ix
...
