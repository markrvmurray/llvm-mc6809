# RUN: llc -mtriple=mc6809 -mcpu=hd6309 -run-pass=postrapseudos -verify-machineinstrs -o - %s | FileCheck %s

# Bug #376: the Push_i8 expansion for the HD6309 byte registers E/F (which page-1
# PSHS cannot push) lowers to `leas -1,s; ste/stf ,s`. It built the LEAS with an
# explicit RegState::Define of SS, so the result carried an extra def-marked
# operand (`LEASi_o5 -1, def $ss, $ss, implicit-def $ss`) that the machine
# verifier rejects ("Explicit operand marked as def" + "Extra explicit operand").
# The SS def is implicit (descriptor Defs); the explicit operands are only the
# offset and the base use. -verify-machineinstrs in the RUN line is the guard:
# a malformed LEAS makes this test fail.

# CHECK-LABEL: name: push_e_byte
# CHECK:      LEASi_o5 -1, $ss, implicit-def $ss
# CHECK-NOT:  LEASi_o5 -1, def $ss
# CHECK:      STEi_o0 $ss
---
name: push_e_byte
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $ae
    $ss = Push_i8 killed $ae, implicit-def $ss, implicit $ss
    RTSr
...

# The F-register sibling lowers through the same path to `leas -1,s; stf ,s`.
# CHECK-LABEL: name: push_f_byte
# CHECK:      LEASi_o5 -1, $ss, implicit-def $ss
# CHECK-NOT:  LEASi_o5 -1, def $ss
# CHECK:      STFi_o0 $ss
---
name: push_f_byte
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $af
    $ss = Push_i8 killed $af, implicit-def $ss, implicit $ss
    RTSr
...
