    %7:acc8_ab = EXTRACT_LO_i16 %13, implicit-def $nz, implicit-def $v
    %8:acc8_ab = EXTRACT_HI_i16 %13, implicit-def $nz, implicit-def $v
    %5:acc8_ab = Load_i8_Imm 0, implicit-def dead $nz, implicit-def dead $v
    %9:acc8_ab = SubSetCarry_i8_Reg %5, %7, implicit-def $nz, implicit-def $v, implicit-def $c, implicit-def %10
    %30:acc8_ab = COPY %5
    %11:acc8_ab = SubSetCarryUse_i8_Reg %30, %8, implicit-def $nz, implicit-def $v, implicit-def $c, implicit $c, implicit-def %12, implicit %10
    %4:acc16 = MERGE_LOHI_i16 %9, %11, implicit-def $nz, implicit-def $v
    Store_i16_MemIndirect %4, %fixed-stack.0, 0, implicit-def dead $nz, implicit-def dead $v :: (store (s16) into %ir.p, align 1)
