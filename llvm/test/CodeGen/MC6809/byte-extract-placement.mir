# RUN: llc -mtriple=mc6809 -run-pass=mc6809-insert-copies -verify-machineinstrs %s -o - | FileCheck %s

# A byte extract is A or B only. Selection emits the extracts of a value
# where it is taken apart, so in a 32-bit shift by a byte three of them
# were live at once before the merges that consume them -- more than A and
# B can hold. The pass moves each to just before its only user. It does
# not move one past a physical D (which holds A and B), nor past an
# instruction that reads a flag the extract sets.

# CHECK-LABEL: name: shl8
# CHECK:       Load_i8_Imm 0
# CHECK-NEXT:  EXTRACT_LO_i16 %2
# CHECK-NEXT:  MERGE_LOHI_i16
# CHECK-NEXT:  EXTRACT_HI_i16 %2
# CHECK-NEXT:  EXTRACT_LO_i16 %3
# CHECK-NEXT:  MERGE_LOHI_i16

# With a physical D live between them and their users, all three stay.
# CHECK-LABEL: name: shl8_physd
# CHECK:       EXTRACT_LO_i16 %2
# CHECK-NEXT:  EXTRACT_HI_i16 %2
# CHECK-NEXT:  EXTRACT_LO_i16 %3
# CHECK-NEXT:  $ad = COPY

--- |
  ; ModuleID = 'shl8.ll'
  source_filename = "shl8.ll"
  target datalayout = "E-p:16:8-p1:8:8-S8-m:e-i1:8-i8:8-i16:8-i32:8-i64:8-f32:8-f64:8-a:0-n8:16"
  target triple = "mc6809"
  
  ; Function Attrs: norecurse
  define i32 @shl8(i32 %a) #0 {
    %r = shl i32 %a, 8
    ret i32 %r
  }

  define i32 @shl8_physd(i32 %a) #0 {
    %r = shl i32 %a, 8
    ret i32 %r
  }
  
  attributes #0 = { norecurse }
...
---
name:            shl8
alignment:       1
exposesReturnsTwice: false
legalized:       true
regBankSelected: true
selected:        true
failedISel:      false
tracksRegLiveness: true
hasWinCFI:       false
noPhis:          false
isSSA:           true
noVRegs:         false
hasFakeUses:     false
callsEHReturn:   false
callsUnwindInit: false
hasEHContTarget: false
hasEHScopes:     false
hasEHFunclets:   false
isOutlined:      false
debugInstrRef:   false
failsVerification: false
tracksDebugUserValues: false
registers:
  - { id: 0, class: _, preferred-register: '', flags: [  ] }
  - { id: 1, class: index16, preferred-register: '', flags: [  ] }
  - { id: 2, class: acc16, preferred-register: '', flags: [  ] }
  - { id: 3, class: acc16, preferred-register: '', flags: [  ] }
  - { id: 4, class: index, preferred-register: '', flags: [  ] }
  - { id: 5, class: index, preferred-register: '', flags: [  ] }
  - { id: 6, class: _, preferred-register: '', flags: [  ] }
  - { id: 7, class: _, preferred-register: '', flags: [  ] }
  - { id: 8, class: acc16, preferred-register: '', flags: [  ] }
  - { id: 9, class: acc16, preferred-register: '', flags: [  ] }
  - { id: 10, class: index, preferred-register: '', flags: [  ] }
  - { id: 11, class: accum, preferred-register: '', flags: [  ] }
  - { id: 12, class: _, preferred-register: '', flags: [  ] }
  - { id: 13, class: acc8_ab, preferred-register: '', flags: [  ] }
  - { id: 14, class: acc8_ab, preferred-register: '', flags: [  ] }
  - { id: 15, class: acc8_ab, preferred-register: '', flags: [  ] }
  - { id: 16, class: _, preferred-register: '', flags: [  ] }
  - { id: 17, class: acc8, preferred-register: '', flags: [  ] }
  - { id: 18, class: _, preferred-register: '', flags: [  ] }
  - { id: 19, class: _, preferred-register: '', flags: [  ] }
  - { id: 20, class: _, preferred-register: '', flags: [  ] }
liveins:         []
frameInfo:
  isFrameAddressTaken: false
  isReturnAddressTaken: false
  hasStackMap:     false
  hasPatchPoint:   false
  stackSize:       0
  offsetAdjustment: 0
  maxAlignment:    1
  adjustsStack:    false
  hasCalls:        false
  framePointerPolicy: none
  stackProtector:  ''
  functionContext: ''
  maxCallFrameSize: 4294967295
  cvBytesOfCalleeSavedRegisters: 0
  hasOpaqueSPAdjustment: false
  hasVAStart:      false
  hasMustTailInVarArgFunc: false
  hasTailCall:     false
  isCalleeSavedInfoValid: false
  localFrameSize:  0
fixedStack:
  - { id: 0, type: default, offset: 0, size: 2, alignment: 1, stack-id: default, 
      isImmutable: true, isAliased: false, callee-saved-register: '', callee-saved-restored: true, 
      debug-info-variable: '', debug-info-expression: '', debug-info-location: '' }
  - { id: 1, type: default, offset: 2, size: 2, alignment: 1, stack-id: default, 
      isImmutable: true, isAliased: false, callee-saved-register: '', callee-saved-restored: true, 
      debug-info-variable: '', debug-info-expression: '', debug-info-location: '' }
stack:           []
entry_values:    []
callSites:       []
debugValueSubstitutions: []
constants:       []
machineFunctionInfo: {}
body:             |
  bb.1 (%ir-block.0):
    liveins: $ix
  
    %1:index16 = COPY $ix
    %2:acc16 = Load_i16_Mem %fixed-stack.1, 0, implicit-def dead $nz, implicit-def dead $v :: (invariant load (s16) from %fixed-stack.1, align 1)
    %3:acc16 = Load_i16_Mem %fixed-stack.0, 0, implicit-def dead $nz, implicit-def dead $v :: (invariant load (s16) from %fixed-stack.0, align 1)
    %13:acc8_ab = EXTRACT_LO_i16 %2, implicit-def $nz, implicit-def $v
    %14:acc8_ab = EXTRACT_HI_i16 %2, implicit-def $nz, implicit-def $v
    %15:acc8_ab = EXTRACT_LO_i16 %3, implicit-def dead $nz, implicit-def dead $v
    %17:acc8 = Load_i8_Imm 0, implicit-def dead $nz, implicit-def dead $v
    %8:acc16 = MERGE_LOHI_i16 %17, %13, implicit-def $nz, implicit-def $v
    %9:acc16 = MERGE_LOHI_i16 %14, %15, implicit-def $nz, implicit-def $v
    Store_i16_Mem %8, %1, i16 2, implicit-def dead $nz, implicit-def dead $v :: (store (s16) into unknown-address + 2, align 1)
    Store_i16_Mem %9, %1, 0, implicit-def dead $nz, implicit-def dead $v :: (store (s16), align 1)
    RTSr
...
---
name:            shl8_physd
alignment:       1
