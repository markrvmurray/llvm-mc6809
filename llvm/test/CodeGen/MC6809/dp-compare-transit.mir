# RUN: llc -mtriple=mc6809 -start-before=mc6809-expand-pseudos %s -o - | FileCheck %s
#
# A 16-bit direct-page register compared with a constant, or tested, is
# loaded into a free X, U or Y and compared there (`ldx <rs ; cmpx #n`),
# which sets the flags CMPD would, instead of through D saved around it
# (`pshs d ; ldd <rs ; cmpd #n ; puls d`). With nothing free, D is saved.
# (A function that has not saved U treats it as live -- LivePhysRegs counts
# an unsaved callee-saved register as pristine -- but these bodies carry no
# callee-saved information, so U is free here when X is not.)

---
# CHECK-LABEL: compare_via_x:
# CHECK-NOT:   pshs
# CHECK:       ldx <__rs0
# CHECK-NEXT:  cmpx #1000
name: compare_via_x
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $ad, $rs0
    $cc = Compare_i16_Imm 7, $rs0, 1000
    RTSr implicit $ad, implicit $cc
...
---
# CHECK-LABEL: compare_via_u:
# CHECK-NOT:   pshs
# CHECK:       ldu <__rs0
# CHECK-NEXT:  cmpu #1000
name: compare_via_u
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $ad, $ix, $rs0
    $cc = Compare_i16_Imm 7, $rs0, 1000
    RTSr implicit $ad, implicit $ix, implicit $cc
...
---
# CHECK-LABEL: compare_saves_d:
# CHECK:       pshs d
# CHECK-NEXT:  ldd <__rs0
# CHECK-NEXT:  cmpd #1000
# CHECK-NEXT:  puls d
name: compare_saves_d
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $ad, $ix, $iy, $su, $rs0
    $cc = Compare_i16_Imm 7, $rs0, 1000
    RTSr implicit $ad, implicit $ix, implicit $iy, implicit $su, implicit $cc
...
