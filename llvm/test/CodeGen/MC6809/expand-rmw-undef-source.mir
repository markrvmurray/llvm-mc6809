# RUN: llc -mtriple=mc6809 -run-pass=mc6809-expand-pseudos -verify-machineinstrs -o - %s | FileCheck %s

# A read-modify-write pseudo on a direct-page register whose tied source is
# undef has no old value to load: `rs0 = undef rs0 & 0` (the upper words of
# a zero-extended value at -O0) must not read __rs0 before writing it.
# CHECK-LABEL: name: and_undef_source
# CHECK-NOT:   LDDd $rs0
# CHECK:       STDd undef $rs0
# CHECK-NOT:   LDDd $rs0
---
name: and_undef_source
tracksRegLiveness: true
body: |
  bb.0:
    renamable $rs0 = AND_i16_Imm undef renamable $rs0, 0, implicit-def dead $nz, implicit-def dead $v
    RTSr implicit $rs0
...

# With a defined source the old value is loaded, as before.
# CHECK-LABEL: name: and_defined_source
# CHECK:       LDDd $rs0
# CHECK:       STDd undef $rs0
---
name: and_defined_source
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $rs0
    renamable $rs0 = AND_i16_Imm killed renamable $rs0, 255, implicit-def dead $nz, implicit-def dead $v
    RTSr implicit $rs0
...
