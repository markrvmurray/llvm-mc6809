# RUN: llc -mtriple=mc6809 -mcpu=hd6309 -run-pass=mc6809-final-lowering -o - %s | FileCheck %s
#
# Bug #346: MC6809FinalLowering::elideDupStores keyed dead-store elision
# on (opcode, offset, base) but did not account for the base register
# being redefined between two stores. The hardware stack pointer $ss is
# adjusted by LEAS during outgoing-argument setup, so two `STQi_o0 $ss`
# stores separated by a `LEAS N,$ss` address DIFFERENT memory (a scratch
# slot vs. a live call-argument slot). The pass treated them as the same
# slot and elided the first (live) store, corrupting a libcall argument
# (manifested as HD6309 f64 log/exp returning NaN).
#
# Both stores must survive: the first is NOT a dead duplicate of the
# second because the intervening LEAS changes what `[$ss+0]` names.

---
name:            dup_store_across_leas
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $aq

    ; CHECK-LABEL: name: dup_store_across_leas
    ; CHECK:      STQi_o0 $ss
    ; CHECK-NEXT: LEASi_o5 4, $ss
    ; CHECK-NEXT: STQi_o0 $ss
    STQi_o0 $ss, implicit-def $nz, implicit-def $n, implicit-def $z, implicit-def $v, implicit $aq
    LEASi_o5 4, $ss, implicit-def $ss
    STQi_o0 $ss, implicit-def $nz, implicit-def $n, implicit-def $z, implicit-def $v, implicit $aq
...
