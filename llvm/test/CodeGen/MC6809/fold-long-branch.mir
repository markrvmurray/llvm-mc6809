# Long branches whose target is within short range shrink.
# CHECK-LABEL: name: shrink
# CHECK:        Bbc_OnlyZ 7, %bb.{{[0-9]+}}, implicit $z
# CHECK:        BRAb %bb.1
---
name: shrink
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $ix
    successors: %bb.1(0x80000000)
  bb.1:
    liveins: $ix
    successors: %bb.2(0x40000000), %bb.3(0x40000000)
    LEAXi_o5 -1, killed renamable $ix, implicit-def renamable $ix, implicit-def $z, implicit-def $z
    LBlbc_OnlyZ 7, %bb.2, implicit $z
  bb.3:
    liveins: $ix
    successors: %bb.1(0x80000000)
    LDAi8 1, implicit-def $aa, implicit-def dead $nz, implicit-def dead $n, implicit-def dead $z, implicit-def dead $v
    LBRAlb %bb.1
  bb.2:
    RTSr
...
