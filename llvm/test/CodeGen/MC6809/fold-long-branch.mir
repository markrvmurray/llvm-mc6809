# RUN: llc -mtriple=mc6809 -run-pass=mc6809-fold-long-branch -verify-machineinstrs -o - %s | FileCheck %s
# Hand-authored: the `b!cc X ; lbra L ; X:` pair BranchRelaxation leaves folds
# back into the 6809's long conditional branch when the far target is the
# likely one or size matters, and long branches whose target is within short
# range shrink. The loop bodies are padded past short range.

--- |
  define void @likely() { ret void }
  define void @unlikely() { ret void }
  define void @unlikely_size() optsize { ret void }
  define void @same_block() { ret void }
  define void @shrink() { ret void }
...

# The far target (the loop's back edge) is the likely one: fold.
# CHECK-LABEL: name: likely
# CHECK:        LEAXi_o5 -1
# CHECK-NEXT:   LBlbc_OnlyZ 6, %bb.1, implicit $z
# CHECK-NOT:    LBRAlb
---
name: likely
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $ix
    successors: %bb.1(0x80000000)
  bb.1:
    liveins: $ix
    successors: %bb.2(0x04000000), %bb.3(0x7c000000)
