# The HD6309 negates E, F and W with COM then ADCR from the zero register
# (COM sets the carry, so the ADCR adds one).  The zero register is postbyte
# code 12 ($C); encoded as anything else the ADCR adds that register too --
# DP, which is not zero in an OS-9 program.
#
# RUN: llc -mtriple=mc6809 -mcpu=hd6309 -start-before=mc6809-expand-pseudos -filetype=obj %s -o - \
# RUN:   | llvm-objdump -d - | FileCheck %s

# CHECK-LABEL: <neg_e>:
# CHECK:       11 43{{[[:space:]]+}}come
# CHECK-NEXT:  10 31 ce{{[[:space:]]+}}adcr
# CHECK-LABEL: <neg_f>:
# CHECK:       11 53{{[[:space:]]+}}comf
# CHECK-NEXT:  10 31 cf{{[[:space:]]+}}adcr
# CHECK-LABEL: <neg_w>:
# CHECK:       10 53{{[[:space:]]+}}comw
# CHECK-NEXT:  10 31 c6{{[[:space:]]+}}adcr

--- |
  define void @neg_e() { ret void }
  define void @neg_f() { ret void }
  define void @neg_w() { ret void }
...
---
name: neg_e
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $ae
    $ae = Negate_i8 killed $ae, implicit-def $nz, implicit-def $c, implicit-def $v
    RTSr implicit $ae
...
---
name: neg_f
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $af
    $af = Negate_i8 killed $af, implicit-def $nz, implicit-def $c, implicit-def $v
    RTSr implicit $af
...
---
name: neg_w
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $aw
    $aw = Negate_i16 killed $aw, implicit-def $nz, implicit-def $c, implicit-def $v
    RTSr implicit $aw
...
