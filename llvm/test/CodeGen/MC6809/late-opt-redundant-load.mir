# RUN: llc -mtriple=mc6809 -mcpu=hd6309 -run-pass=mc6809-late-opt -verify-machineinstrs -o - %s | FileCheck %s

# MC6809LateOptimization::elideRedundantLoad drops a direct-page load whose
# value register still provably holds the same slot's contents from an earlier
# identical load. A direct-page store to a DIFFERENT slot (carrying
# hasSideEffects) is walked past -- distinct imaginary slots are distinct
# addresses and the store leaves the value register untouched. The removed
# load's flags must be dead, and the value register's kill flags on the
# intervening store are cleared so it stays live to the reload's former uses.

# Positive: ldd <rs0> ; std <rs1> ; ldd <rs0>  ->  ldd <rs0> ; std <rs1>
# The store's `killed $ad` becomes a plain use once the reload is gone.
# CHECK-LABEL: name: reload_across_disjoint_store
# CHECK:      LDDd $rs0
# CHECK-NEXT: STDd undef $rs1{{.*}}implicit $ad, implicit-def $rs1
# CHECK-NOT:  LDDd $rs0
---
name: reload_across_disjoint_store
tracksRegLiveness: true
body: |
  bb.0:
    successors: %bb.1
    liveins: $rs0
    LDDd $rs0, implicit-def $nz, implicit-def $n, implicit-def $z, implicit-def $v, implicit-def $aa, implicit-def $ab, implicit-def $ad, implicit-def $aq
    STDd undef $rs1, implicit-def $nz, implicit-def $n, implicit-def $z, implicit-def $v, implicit killed $ad, implicit-def $rs1
    LDDd $rs0, implicit-def $nz, implicit-def $n, implicit-def $z, implicit-def $v, implicit-def $aa, implicit-def $ab, implicit-def $ad, implicit-def $aq

  bb.1:
    liveins: $ad, $rs0, $rs1
    ADDDi16 -1, implicit-def $ad, implicit-def $nz, implicit-def $n, implicit-def $z, implicit-def $v, implicit-def $c, implicit-def $aa, implicit-def $ab, implicit killed $ad
    RTSr implicit $ad
...

# A store to the SAME slot from the same register leaves D holding exactly
# what the slot holds, and the same N/Z/V (both set N and Z from the value
# and clear V): the reload after it is redundant, flags included, and the
# store's killed use of D is cleared so D stays live to the return.
# CHECK-LABEL: name: reload_after_same_slot_store
# CHECK:      LDDd $rs0
# CHECK-NEXT: STDd undef $rs0, implicit-def $nz, implicit-def $n, implicit-def $z, implicit-def $v, implicit $ad
# CHECK-NEXT: RTSr implicit $ad
---
name: reload_after_same_slot_store
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $rs0, $ad
    LDDd $rs0, implicit-def $nz, implicit-def $n, implicit-def $z, implicit-def $v, implicit-def $aa, implicit-def $ab, implicit-def $ad, implicit-def $aq
    STDd undef $rs0, implicit-def $nz, implicit-def $n, implicit-def $z, implicit-def $v, implicit killed $ad, implicit-def $rs0
    LDDd $rs0, implicit-def $nz, implicit-def $n, implicit-def $z, implicit-def $v, implicit-def $aa, implicit-def $ab, implicit-def $ad, implicit-def $aq
    RTSr implicit $ad
...

# Negative: a store from a DIFFERENT register to the slot rewrites its memory
# without touching D, so the reload is needed.
# CHECK-LABEL: name: reload_after_other_reg_store
# CHECK:      LDDd $rs0
# CHECK:      STXd undef $rs0
# CHECK:      LDDd $rs0
---
name: reload_after_other_reg_store
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $rs0, $ad, $ix
    LDDd $rs0, implicit-def $nz, implicit-def $n, implicit-def $z, implicit-def $v, implicit-def $aa, implicit-def $ab, implicit-def $ad, implicit-def $aq
    STXd undef $rs0, implicit-def $nz, implicit-def $n, implicit-def $z, implicit-def $v, implicit killed $ix, implicit-def $rs0
    LDDd $rs0, implicit-def $nz, implicit-def $n, implicit-def $z, implicit-def $v, implicit-def $aa, implicit-def $ab, implicit-def $ad, implicit-def $aq
    RTSr implicit $ad
...

# The reload's flags are live (the branch reads Z), but nothing between the
# store and the reload rewrites them: the store's own N/Z/V serve.
# CHECK-LABEL: name: reload_flags_from_store
# CHECK:      ADDDi16 -1
# CHECK-NEXT: STDd undef $rs0, implicit-def $nz, implicit-def $n, implicit-def $z, implicit-def $v, implicit $ad
# CHECK-NEXT: Bbc_OnlyZ 6, %bb.1, implicit $z
---
name: reload_flags_from_store
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $rs0, $ad
    ADDDi16 -1, implicit-def $ad, implicit-def $nz, implicit-def $n, implicit-def $z, implicit-def $v, implicit-def $c, implicit-def $aa, implicit-def $ab, implicit killed $ad
    STDd undef $rs0, implicit-def dead $nz, implicit-def dead $n, implicit-def dead $z, implicit-def dead $v, implicit killed $ad, implicit-def $rs0
    LDDd $rs0, implicit-def $nz, implicit-def $n, implicit-def $z, implicit-def $v, implicit-def $aa, implicit-def $ab, implicit-def $ad, implicit-def $aq
    Bbc_OnlyZ 6, %bb.1, implicit $z
  bb.1:
    liveins: $ad
    RTSr implicit $ad
...
