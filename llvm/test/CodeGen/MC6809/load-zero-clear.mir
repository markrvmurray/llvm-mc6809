# RUN: llc -mtriple=mc6809 -run-pass=mc6809-expand-pseudos -verify-machineinstrs -o - %s | FileCheck %s

# A load of 0 into an accumulator becomes a clear (a byte shorter, as fast,
# same N/Z/V) -- but a clear also clears C, so only when C is dead after it.

# C dead: clrb.
# CHECK-LABEL: name: zero_c_dead
# CHECK:       CLRBa
# CHECK-NOT:   LDBi8
---
name: zero_c_dead
tracksRegLiveness: true
body: |
  bb.0:
    renamable $ab = Load_i8_Imm 0, implicit-def dead $nz, implicit-def dead $v
    RTSr implicit $ab
...

# C live (the add with carry reads the C the subtract set): ldb #0.
# CHECK-LABEL: name: zero_c_live
# CHECK:       LDBi8 0
# CHECK-NOT:   CLRBa
---
name: zero_c_live
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $aa
    SUBAi8 1, implicit-def $aa, implicit-def $nz, implicit-def $n, implicit-def $z, implicit-def $v, implicit-def $c, implicit-def $aa, implicit $aa
    renamable $ab = Load_i8_Imm 0, implicit-def dead $nz, implicit-def dead $v
    ADCBi8 0, implicit-def $ab, implicit-def $nz, implicit-def $n, implicit-def $z, implicit-def $v, implicit-def $c, implicit-def $ab, implicit $ab, implicit $c
    RTSr implicit $aa, implicit $ab
...
