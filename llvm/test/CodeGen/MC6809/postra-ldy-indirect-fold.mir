# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=mc6809 -run-pass=mc6809-spill-opt -o - %s | FileCheck %s

# Regression sentinel for bug #189 (Stage 6 of MC6809PostRASpillOpt).
#
# Folds the pattern
#     LDY  n,u            ; MI1 — load pointer
#     ... (gap of 0..MaxGap=5 MIs that don't touch Y) ...
#     op   ,Y             ; MI2 — dereference via Y, offset 0
#     ... after MI2, Y must be dead ...
# into
#     ... gap MIs unchanged ...
#     op   [n,u]          ; indirect-indexed; MI1 erased
#
# Saves 2-3 bytes (the LDY) and ~3-6 cycles per fold.
#
# Coverage:
#   * `fold_o0_byte`             — LDY 0,u / ORB ,Y / Y dead → ORBi_o0I.
#   * `fold_o8_byte`             — LDY 5,u / ORB ,Y / Y dead → ORBi_o8I.
#   * `fold_o16_word`            — LDY 200,u / CMPD ,Y / Y dead → CMPDi_o16I.
#   * `fold_with_gap3`           — LDY 5,u / 3 frame ops / ORB ,Y → ORBi_o8I.
#   * `negative_y_reused`        — LDY 5,u / ORB ,Y / TFRpp Y to X — must
#                                  NOT fold (Y is read past MI2).
#   * `negative_y_clobbered_in_gap` — LDY 5,u / LDY 6,u / ORB ,Y — first
#                                  LDY must NOT fold (the second LDY
#                                  redefines Y in the gap); the second
#                                  LDY+ORB pair WILL fold.

--- |
  define void @fold_o0_byte() { ret void }
  define void @fold_o8_byte() { ret void }
  define void @fold_o16_word() { ret void }
  define void @fold_with_gap3() { ret void }
  define void @negative_y_reused() { ret void }
  define void @negative_y_clobbered_in_gap() { ret void }
...

---
name: fold_o0_byte
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $su
    ; CHECK-LABEL: name: fold_o0_byte
    ; CHECK: liveins: $su
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: ORBi_o0I $su, implicit-def $ab, implicit-def $nz, implicit-def $n, implicit-def $z, implicit-def $v, implicit-def $ad, implicit-def $aq, implicit $ab
    ; CHECK-NEXT: RTSr
    LDYi_o0 $su, implicit-def $iy, implicit-def $nz, implicit-def $n, implicit-def $z, implicit-def $v
    ORBi_o0 $iy, implicit-def $ab, implicit-def $nz, implicit-def $n, implicit-def $z, implicit-def $v, implicit-def $ad, implicit-def $aq, implicit $ab
    RTSr
...

---
name: fold_o8_byte
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $su, $ab
    ; CHECK-LABEL: name: fold_o8_byte
    ; CHECK: liveins: $su, $ab
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: ORBi_o8I 5, $su, implicit-def $ab, implicit-def $nz, implicit-def $n, implicit-def $z, implicit-def $v, implicit-def $ad, implicit-def $aq, implicit $ab
    ; CHECK-NEXT: RTSr
    LDYi_o5 5, $su, implicit-def $iy, implicit-def $nz, implicit-def $n, implicit-def $z, implicit-def $v
    ORBi_o0 $iy, implicit-def $ab, implicit-def $nz, implicit-def $n, implicit-def $z, implicit-def $v, implicit-def $ad, implicit-def $aq, implicit $ab
    RTSr
...

---
name: fold_o16_word
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $su, $ad
    ; CHECK-LABEL: name: fold_o16_word
    ; CHECK: liveins: $su, $ad
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: CMPDi_o16I 200, $su, implicit-def $nz, implicit-def $n, implicit-def $z, implicit-def $v, implicit-def $c, implicit $ad
    ; CHECK-NEXT: RTSr
    LDYi_o16 200, $su, implicit-def $iy, implicit-def $nz, implicit-def $n, implicit-def $z, implicit-def $v
    CMPDi_o0 $iy, implicit-def $nz, implicit-def $n, implicit-def $z, implicit-def $v, implicit-def $c, implicit $ad
    RTSr
...

---
name: fold_with_gap3
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $su, $aa, $ab
    ; CHECK-LABEL: name: fold_with_gap3
    ; CHECK: liveins: $su, $aa, $ab
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: LDAi_o5 1, $su, implicit-def $aa, implicit-def $nz, implicit-def $n, implicit-def $z, implicit-def $v, implicit-def $ad, implicit-def $aq
    ; CHECK-NEXT: STAi_o5 2, $su, implicit $aa, implicit-def $nz, implicit-def $n, implicit-def $z, implicit-def $v
    ; CHECK-NEXT: STBi_o5 3, $su, implicit $ab, implicit-def $nz, implicit-def $n, implicit-def $z, implicit-def $v
    ; CHECK-NEXT: ORBi_o8I 5, $su, implicit-def $ab, implicit-def $nz, implicit-def $n, implicit-def $z, implicit-def $v, implicit-def $ad, implicit-def $aq, implicit $ab
    ; CHECK-NEXT: RTSr
    LDYi_o5 5, $su, implicit-def $iy, implicit-def $nz, implicit-def $n, implicit-def $z, implicit-def $v
    LDAi_o5 1, $su, implicit-def $aa, implicit-def $nz, implicit-def $n, implicit-def $z, implicit-def $v, implicit-def $ad, implicit-def $aq
    STAi_o5 2, $su, implicit $aa, implicit-def $nz, implicit-def $n, implicit-def $z, implicit-def $v
    STBi_o5 3, $su, implicit $ab, implicit-def $nz, implicit-def $n, implicit-def $z, implicit-def $v
    ORBi_o0 $iy, implicit-def $ab, implicit-def $nz, implicit-def $n, implicit-def $z, implicit-def $v, implicit-def $ad, implicit-def $aq, implicit $ab
    RTSr
...

---
name: negative_y_reused
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $su, $ab
    ; Y is used after MI2 (TFR Y,X) — fold MUST abort.
    ; CHECK-LABEL: name: negative_y_reused
    ; CHECK: liveins: $su, $ab
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: LDYi_o5 5, $su, implicit-def $iy, implicit-def $nz, implicit-def $n, implicit-def $z, implicit-def $v
    ; CHECK-NEXT: ORBi_o0 $iy, implicit-def $ab, implicit-def $nz, implicit-def $n, implicit-def $z, implicit-def $v, implicit-def $ad, implicit-def $aq, implicit $ab
    ; CHECK-NEXT: $ix = TFRp $iy, implicit-def $nz
    ; CHECK-NEXT: RTSr
    LDYi_o5 5, $su, implicit-def $iy, implicit-def $nz, implicit-def $n, implicit-def $z, implicit-def $v
    ORBi_o0 $iy, implicit-def $ab, implicit-def $nz, implicit-def $n, implicit-def $z, implicit-def $v, implicit-def $ad, implicit-def $aq, implicit $ab
    $ix = TFRp $iy, implicit-def $nz
    RTSr
...

---
name: negative_y_clobbered_in_gap
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $su, $ab
    ; First LDY must NOT fold — the second LDY redefines Y in the
    ; gap. The SECOND LDY+ORB pair WILL fold (Y is dead after the
    ; ORB), so the first LDY remains and the second LDY is replaced
    ; by the indirect ORB.
    ; CHECK-LABEL: name: negative_y_clobbered_in_gap
    ; CHECK: liveins: $su, $ab
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: LDYi_o5 5, $su, implicit-def $iy, implicit-def $nz, implicit-def $n, implicit-def $z, implicit-def $v
    ; CHECK-NEXT: ORBi_o8I 6, $su, implicit-def $ab, implicit-def $nz, implicit-def $n, implicit-def $z, implicit-def $v, implicit-def $ad, implicit-def $aq, implicit $ab
    ; CHECK-NEXT: RTSr
    LDYi_o5 5, $su, implicit-def $iy, implicit-def $nz, implicit-def $n, implicit-def $z, implicit-def $v
    LDYi_o5 6, $su, implicit-def $iy, implicit-def $nz, implicit-def $n, implicit-def $z, implicit-def $v
    ORBi_o0 $iy, implicit-def $ab, implicit-def $nz, implicit-def $n, implicit-def $z, implicit-def $v, implicit-def $ad, implicit-def $aq, implicit $ab
    RTSr
...
