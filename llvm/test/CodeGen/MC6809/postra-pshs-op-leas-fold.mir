# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=mc6809 -run-pass=mc6809-spill-opt -o - %s | FileCheck %s

# Regression sentinel for bug #185 (Stage 5 of MC6809PostRASpillOpt).
#
# Folds the three-instruction triplet
#     PSHS reg
#     op   ,S          ; or `op 0,S` (the _o5 form with imm=0)
#     LEAS N,S         ; N = 1 for byte regs, 2 for word regs
# into the two-instruction post-increment form
#     PSHS reg
#     op   ,S{+,++}    ; *i_Inc1 (byte) or *i_Inc2 (word)
#
# Saves 2 bytes and 5 cycles per occurrence (the LEAS instruction
# is `0x32 0x6N` = 2 bytes, 5 cycles).
#
# Each function below covers one shape:
#   * `fold_orb_byte`  — PSHS B / ORB 0,S / LEAS 1,S → PSHS B / ORB ,S+
#   * `fold_ora_byte`  — PSHS A / ORA 0,S / LEAS 1,S → PSHS A / ORA ,S+
#   * `fold_cmpd_word` — PSHS D / CMPD 0,S / LEAS 2,S → PSHS D / CMPD ,S++
#   * `negative_wrong_imm` — PSHS A / ORA 0,S / LEAS 2,S — must NOT
#     fold (LEAS imm doesn't match push width); MC6809PostRASpillOpt
#     must leave the triplet alone.
#
# Phase 2 (bug #185 follow-up): MaxGap=3 intervening MIs allowed
# between PSHS and op, provided none modify SS.
#   * `fold_with_gap1` — PSHS B / LDB 5,u / ORB ,S / LEAS 1,S
#     → ORB folds; LDB stays put.
#   * `fold_with_gap3` — PSHS A / LDA / STB / LDB / ORA ,S / LEAS 1,S
#     → ORA folds; three intervening frame ops stay put.
#   * `negative_s_clobber` — PSHS A / PSHS B / ORA ,S / LEAS 1,S —
#     must NOT fold (the second PSHS modifies SS, so the slot has
#     shifted; safety abort fires and the four MIs all remain).

--- |
  define void @fold_orb_byte() { ret void }
  define void @fold_ora_byte() { ret void }
  define void @fold_cmpd_word() { ret void }
  define void @negative_wrong_imm() { ret void }
  define void @fold_with_gap1() { ret void }
  define void @fold_with_gap3() { ret void }
  define void @negative_s_clobber() { ret void }
...

---
name: fold_orb_byte
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $ab
    ; CHECK-LABEL: name: fold_orb_byte
    ; CHECK: liveins: $ab
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: PSHSs $ab, implicit-def $ss, implicit $ss
    ; CHECK-NEXT: ORBi_Inc1 $ss, implicit-def $ab, implicit-def $nz, implicit-def $n, implicit-def $z, implicit-def $v, implicit-def $ad, implicit-def $aq, implicit $ab
    ; CHECK-NEXT: RTSr
    PSHSs $ab, implicit-def $ss, implicit $ss
    ORBi_o5 0, $ss, implicit-def $ab, implicit-def $nz, implicit-def $n, implicit-def $z, implicit-def $v, implicit-def $ad, implicit-def $aq, implicit $ab
    LEASi_o5 1, $ss, implicit-def $ss, implicit $ss
    RTSr
...

---
name: fold_ora_byte
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $aa
    ; CHECK-LABEL: name: fold_ora_byte
    ; CHECK: liveins: $aa
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: PSHSs $aa, implicit-def $ss, implicit $ss
    ; CHECK-NEXT: ORAi_Inc1 $ss, implicit-def $aa, implicit-def $nz, implicit-def $n, implicit-def $z, implicit-def $v, implicit-def $ad, implicit-def $aq, implicit $aa
    ; CHECK-NEXT: RTSr
    PSHSs $aa, implicit-def $ss, implicit $ss
    ORAi_o5 0, $ss, implicit-def $aa, implicit-def $nz, implicit-def $n, implicit-def $z, implicit-def $v, implicit-def $ad, implicit-def $aq, implicit $aa
    LEASi_o5 1, $ss, implicit-def $ss, implicit $ss
    RTSr
...

---
name: fold_cmpd_word
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $ad
    ; CHECK-LABEL: name: fold_cmpd_word
    ; CHECK: liveins: $ad
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: PSHSs $ad, implicit-def $ss, implicit $ss
    ; CHECK-NEXT: CMPDi_Inc2 $ss, implicit-def $nz, implicit-def $n, implicit-def $z, implicit-def $v, implicit-def $c, implicit $ad
    ; CHECK-NEXT: RTSr
    PSHSs $ad, implicit-def $ss, implicit $ss
    CMPDi_o5 0, $ss, implicit-def $nz, implicit-def $n, implicit-def $z, implicit-def $v, implicit-def $c, implicit $ad
    LEASi_o5 2, $ss, implicit-def $ss, implicit $ss
    RTSr
...

