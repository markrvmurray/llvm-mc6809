    ; CHECK-NEXT: ORBi_Inc1 $ss, implicit-def $ab, implicit-def $nz, implicit-def $n, implicit-def $z, implicit-def $v, implicit-def $ad, implicit-def $aq, implicit $ab
    ; CHECK-NEXT: RTSr
    PSHSs $ab, implicit-def $ss, implicit $ss
    LDBi_o5 5, $su, implicit-def $ab, implicit-def $nz, implicit-def $n, implicit-def $z, implicit-def $v, implicit-def $ad, implicit-def $aq
    ORBi_o5 0, $ss, implicit-def $ab, implicit-def $nz, implicit-def $n, implicit-def $z, implicit-def $v, implicit-def $ad, implicit-def $aq, implicit $ab
    LEASi_o5 1, $ss, implicit-def $ss, implicit $ss
