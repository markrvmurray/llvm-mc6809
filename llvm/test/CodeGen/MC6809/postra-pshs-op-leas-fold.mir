    ; CHECK-NEXT: PSHSs $aa, implicit-def $ss, implicit $ss
    ; CHECK-NEXT: LDAi_o5 5, $su, implicit-def $aa, implicit-def $nz, implicit-def $n, implicit-def $z, implicit-def $v, implicit-def $ad, implicit-def $aq
    ; CHECK-NEXT: STBi_o5 4, $su, implicit $ab, implicit-def $nz, implicit-def $n, implicit-def $z, implicit-def $v
    ; CHECK-NEXT: LDBi_o5 6, $su, implicit-def $ab, implicit-def $nz, implicit-def $n, implicit-def $z, implicit-def $v, implicit-def $ad, implicit-def $aq
    ; CHECK-NEXT: ORAi_Inc1 $ss, implicit-def $aa, implicit-def $nz, implicit-def $n, implicit-def $z, implicit-def $v, implicit-def $ad, implicit-def $aq, implicit $aa
    ; CHECK-NEXT: RTSr
    PSHSs $aa, implicit-def $ss, implicit $ss
    LDAi_o5 5, $su, implicit-def $aa, implicit-def $nz, implicit-def $n, implicit-def $z, implicit-def $v, implicit-def $ad, implicit-def $aq
    STBi_o5 4, $su, implicit $ab, implicit-def $nz, implicit-def $n, implicit-def $z, implicit-def $v
    LDBi_o5 6, $su, implicit-def $ab, implicit-def $nz, implicit-def $n, implicit-def $z, implicit-def $v, implicit-def $ad, implicit-def $aq
    ORAi_o5 0, $ss, implicit-def $aa, implicit-def $nz, implicit-def $n, implicit-def $z, implicit-def $v, implicit-def $ad, implicit-def $aq, implicit $aa
    LEASi_o5 1, $ss, implicit-def $ss, implicit $ss
    RTSr
...

---
name: negative_s_clobber
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $aa, $ab
    ; A second PSHS in the gap modifies SS — fold MUST abort. The
    ; four MIs all stay put.
    ; CHECK-LABEL: name: negative_s_clobber
    ; CHECK: liveins: $aa, $ab
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: PSHSs $aa, implicit-def $ss, implicit $ss
    ; CHECK-NEXT: PSHSs $ab, implicit-def $ss, implicit $ss
    ; CHECK-NEXT: ORAi_o5 1, $ss, implicit-def $aa, implicit-def $nz, implicit-def $n, implicit-def $z, implicit-def $v, implicit-def $ad, implicit-def $aq, implicit $aa
    ; CHECK-NEXT: LEASi_o5 2, $ss, implicit-def $ss, implicit $ss
    ; CHECK-NEXT: RTSr
    PSHSs $aa, implicit-def $ss, implicit $ss
    PSHSs $ab, implicit-def $ss, implicit $ss
    ORAi_o5 1, $ss, implicit-def $aa, implicit-def $nz, implicit-def $n, implicit-def $z, implicit-def $v, implicit-def $ad, implicit-def $aq, implicit $aa
