entry:
  %arrayidx = getelementptr inbounds nuw i8, ptr %p, i16 3
  %0 = load i8, ptr %arrayidx, align 1, !tbaa !8
  %cmp = icmp eq i8 %0, %x
  %conv2 = zext i1 %cmp to i16
  ret i16 %conv2
