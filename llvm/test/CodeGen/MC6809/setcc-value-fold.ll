; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py
; RUN: llc -mtriple=mc6809 -mcpu=mc6809 -O2 -global-isel < %s | FileCheck %s --check-prefix=MC6809
; RUN: llc -mtriple=mc6809 -mcpu=hd6309 -O2 -global-isel < %s | FileCheck %s --check-prefix=HD6309
;
; Bug #383: a compare in a VALUE context (`int r = *p == x`) folds its memory
; operand into the compare's addressing mode (cmp ,p / cmp k,p / cmp [n,r]) +
; ConditionalImm, instead of loading it into an accumulator first. The setcc
; value is selected by the C++ G_ICMP arm (the SetIfCondPat Pats do not import
; into GISel), which now mirrors the G_BRCOND memory-fold.

target datalayout = "E-p:16:8-p1:8:8-S8-m:e-i1:8-i8:8-i16:8-i32:8-i64:8-f32:8-f64:8-a:0-n8:16"
target triple = "mc6809-unknown-unknown"

; Function Attrs: mustprogress nofree norecurse nosync nounwind willreturn memory(argmem: read)
define dso_local range(i16 0, 2) i16 @eqv(ptr noundef readonly captures(none) %p, i8 noundef signext %x) local_unnamed_addr #0 {
; MC6809-LABEL: eqv:
; MC6809:       ; %bb.0: ; %entry
; MC6809-NEXT:    leas -2,s
; MC6809-NEXT:    cmpb ,x
; MC6809-NEXT:    lbeq .LBB0_2
; MC6809-NEXT:  ; %bb.1: ; %entry
; MC6809-NEXT:    ldb #0
; MC6809-NEXT:    bra .LBB0_3
; MC6809-NEXT:  .LBB0_2: ; %entry
; MC6809-NEXT:    ldb #1
; MC6809-NEXT:  .LBB0_3: ; %entry
; MC6809-NEXT:    andb #1
; MC6809-NEXT:    clra
; MC6809-NEXT:    tfr d,x
; MC6809-NEXT:    leas 2,s
; MC6809-NEXT:    rts
;
; HD6309-LABEL: eqv:
; HD6309:       ; %bb.0: ; %entry
; HD6309-NEXT:    leas -2,s
; HD6309-NEXT:    cmpb ,x
; HD6309-NEXT:    lbeq .LBB0_2
; HD6309-NEXT:  ; %bb.1: ; %entry
; HD6309-NEXT:    ldb #0
; HD6309-NEXT:    bra .LBB0_3
; HD6309-NEXT:  .LBB0_2: ; %entry
; HD6309-NEXT:    ldb #1
; HD6309-NEXT:  .LBB0_3: ; %entry
; HD6309-NEXT:    andb #1
; HD6309-NEXT:    clra
; HD6309-NEXT:    tfr d,x
; HD6309-NEXT:    leas 2,s
; HD6309-NEXT:    rts
entry:
  %0 = load i8, ptr %p, align 1, !tbaa !8
  %cmp = icmp eq i8 %0, %x
  %conv2 = zext i1 %cmp to i16
  ret i16 %conv2
}

; Function Attrs: mustprogress nofree norecurse nosync nounwind willreturn memory(argmem: read)
define dso_local range(i16 0, 2) i16 @idxv(ptr noundef readonly captures(none) %p, i8 noundef signext %x) local_unnamed_addr #0 {
