# RUN: llc -mtriple=mc6809 -mcpu=hd6309 -O2 -run-pass=mc6809-spill-opt -verify-machineinstrs %s -o - | FileCheck %s
#
# A store invalidates every mirror whose bytes it overwrites, unless it writes
# that mirror's register back to the very same bytes. STQ (and STS) count as
# stores; a register's position inside a wider stored register is its
# big-endian byte offset: `stq 2,s` writes D to 2-3 and W to 4-5.

# The STQ writes W over the D mirror at 4,s: the reload stays.
# CHECK-LABEL: name: q_store_over_d
# CHECK:       LDDi_o8 4, $ss
# CHECK-NEXT:  STQi_o8 2, $ss
# CHECK-NEXT:  LDDi_o8 4, $ss
---
name: q_store_over_d
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $aw
    LDDi_o8 4, $ss, implicit-def $nz, implicit-def $n, implicit-def $z, implicit-def $v, implicit-def $aa, implicit-def $ab, implicit-def $ad, implicit-def $aq
    STQi_o8 2, $ss, implicit-def $nz, implicit-def $n, implicit-def $z, implicit-def $v, implicit $aq
    LDDi_o8 4, $ss, implicit-def $nz, implicit-def $n, implicit-def $z, implicit-def $v, implicit-def $aa, implicit-def $ab, implicit-def $ad, implicit-def $aq
    RTSr implicit $ad
...
# The STQ writes D back to 4-5, where D's mirror is: the reload goes.
# CHECK-LABEL: name: q_store_own_bytes
# CHECK:       STQi_o8 4, $ss
# CHECK-NOT:   LDDi_o8
---
name: q_store_own_bytes
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $aw
    LDDi_o8 4, $ss, implicit-def $nz, implicit-def $n, implicit-def $z, implicit-def $v, implicit-def $aa, implicit-def $ab, implicit-def $ad, implicit-def $aq
    STQi_o8 4, $ss, implicit-def $nz, implicit-def $n, implicit-def $z, implicit-def $v, implicit $aq
    LDDi_o8 4, $ss, implicit-def $nz, implicit-def $n, implicit-def $z, implicit-def $v, implicit-def $aa, implicit-def $ab, implicit-def $ad, implicit-def $aq
    RTSr implicit $ad
...
# STX writes X back over X's own mirror: the reload goes.
# CHECK-LABEL: name: x_store_own_bytes
# CHECK:       STXi_o8 16, $ss
# CHECK-NOT:   LDXi_o8
---
name: x_store_own_bytes
tracksRegLiveness: true
body: |
  bb.0:
    LDXi_o8 16, $ss, implicit-def $nz, implicit-def $n, implicit-def $z, implicit-def $v, implicit-def $ix
    STXi_o8 16, $ss, implicit-def $nz, implicit-def $n, implicit-def $z, implicit-def $v, implicit $ix
    LDXi_o8 16, $ss, implicit-def $nz, implicit-def $n, implicit-def $z, implicit-def $v, implicit-def $ix
    RTSr implicit $ix
...
