; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py
; RUN: llc -mtriple=mc6809-unknown-os9 -O2 %s -o - | FileCheck %s

; On OS-9, U is the process's data-area base, so a function that realigns
; its frame takes Y as the frame pointer instead: Y is pushed, set from S,
; and reaches the incoming stack arguments while the locals are addressed
; from the rounded-down S; `tfr y,s` releases the frame. Y is reserved in
; such a function, and U is left alone. When D carries an argument it is
; saved below Y and reloaded, as with U on bare metal.

declare void @use(ptr)
declare void @usec(ptr, i8)

define void @aligned16() {
; CHECK-LABEL: aligned16:
; CHECK:       ; %bb.0: ; %entry
; CHECK-NEXT:    pshs y
; CHECK-NEXT:    tfr s,y
; CHECK-NEXT:    leas -32,s
; CHECK-NEXT:    tfr s,d
; CHECK-NEXT:    andb #240
; CHECK-NEXT:    tfr d,s
; CHECK-NEXT:    leax ,s
; CHECK-NEXT:    lbsr use
; CHECK-NEXT:    tfr y,s
; CHECK-NEXT:    puls y,pc
entry:
  %buf = alloca [32 x i8], align 16
  call void @use(ptr %buf)
  ret void
}

define i16 @stack_args(i16 %a, i16 %b, i16 %c, i16 %d) {
; CHECK-LABEL: stack_args:
; CHECK:       ; %bb.0: ; %entry
; CHECK-NEXT:    pshs y
; CHECK-NEXT:    tfr s,y
; CHECK-NEXT:    leas -16,s
; CHECK-NEXT:    tfr s,d
; CHECK-NEXT:    andb #248
; CHECK-NEXT:    tfr d,s
; CHECK-NEXT:    stx 6,s ; 2-byte Folded Spill
; CHECK-NEXT:    leax 8,s
; CHECK-NEXT:    lbsr use
; CHECK-NEXT:    ldd 6,s
; CHECK-NEXT:    addd 4,y
; CHECK-NEXT:    addd 6,y
; CHECK-NEXT:    addd 8,y
; CHECK-NEXT:    tfr d,x
; CHECK-NEXT:    tfr y,s
; CHECK-NEXT:    puls y,pc
entry:
  %x = alloca [3 x i8], align 8
  call void @use(ptr %x)
  %add = add i16 %b, %a
  %add1 = add i16 %add, %c
  %add2 = add i16 %add1, %d
  ret i16 %add2
}

define void @arg_in_b(ptr %p, i8 zeroext %c) {
; CHECK-LABEL: arg_in_b:
; CHECK:       ; %bb.0: ; %entry
; CHECK-NEXT:    pshs y
; CHECK-NEXT:    tfr s,y
; CHECK-NEXT:    pshs d
; CHECK-NEXT:    leas -12,s
; CHECK-NEXT:    tfr s,d
; CHECK-NEXT:    andb #252
; CHECK-NEXT:    tfr d,s
; CHECK-NEXT:    ldd -2,y
; CHECK-NEXT:    stb 1,s ; 1-byte Folded Spill
; CHECK-NEXT:    stx 2,s ; 2-byte Folded Spill
; CHECK-NEXT:    leax 4,s
; CHECK-NEXT:    stb 4,s
; CHECK-NEXT:    lbsr usec
; CHECK-NEXT:    ldx 2,s ; 2-byte Folded Reload
; CHECK-NEXT:    ldb 1,s ; 1-byte Folded Reload
; CHECK-NEXT:    lbsr usec
; CHECK-NEXT:    tfr y,s
; CHECK-NEXT:    puls y,pc
entry:
  %x = alloca [5 x i8], align 4
  store i8 %c, ptr %x, align 4
  call void @usec(ptr %x, i8 zeroext %c)
  call void @usec(ptr %p, i8 zeroext %c)
  ret void
}
