; A local aligned beyond 1 byte realigns the frame. The callee-saved
; registers are pushed, U takes S as the frame pointer, the locals are
; allocated below it and S is rounded down through D; the locals are then
; addressed from S and the incoming stack arguments from U. When D carries
; an argument (B here) it is saved below U and reloaded. `tfr u,s` in the
; epilogue releases it all. An alignment above 256 needs the high byte
; masked too.
;
; The overflow flag of a 64-bit multiply goes through a 2-byte stack
; temporary, which must not ask for alignment: mulo does not realign.


define dso_local void @aligned16() local_unnamed_addr {
; CHECK-LABEL: aligned16:
; CHECK:       ; %bb.0: ; %entry
; CHECK-NEXT:    pshs u
; CHECK-NEXT:    tfr s,u
; CHECK-NEXT:    leas -32,s
; CHECK-NEXT:    tfr s,d
; CHECK-NEXT:    andb #240
; CHECK-NEXT:    tfr d,s
; CHECK-NEXT:    leax ,s
; CHECK-NEXT:    lbsr use
; CHECK-NEXT:    tfr u,s
; CHECK-NEXT:    puls u,pc
entry:
  %buf = alloca [32 x i8], align 16
  call void @llvm.lifetime.start.p0(ptr nonnull %buf)
  call void @use(ptr noundef nonnull %buf)
  call void @llvm.lifetime.end.p0(ptr nonnull %buf)
  ret void
}

