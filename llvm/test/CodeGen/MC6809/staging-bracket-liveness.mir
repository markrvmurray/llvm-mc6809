# RUN: llc -mtriple=mc6809 -run-pass=mc6809-expand-pseudos -verify-machineinstrs -o - %s | FileCheck %s

# A copy between direct-page registers goes through D. D needs saving
# around it only if something reads D after the copy -- not merely because
# D holds a value going into it.

# D is overwritten before anything reads it: no save.
# CHECK-LABEL: name: dead_after
# CHECK-NOT:  PSHSs
# CHECK:      LDDd $rs2
# The store reads the D it stores (its descriptor says so).
# CHECK-NEXT: STDd undef $rs0{{.*}}implicit $ad
# CHECK-NOT:  PULSs
---
name: dead_after
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $ad, $rs2
    $rs0 = COPY killed $rs2
    LDDi16 5, implicit-def $nz, implicit-def $n, implicit-def $z, implicit-def $v, implicit-def $aa, implicit-def $ab, implicit-def $ad, implicit-def $aq
    RTSr implicit $ad, implicit $rs0
...

# D is returned, and X, U and Y are busy: D is saved and restored.
# CHECK-LABEL: name: live_after
# CHECK:      PSHSs $ad
# CHECK-NEXT: LDDd $rs2
# CHECK-NEXT: STDd undef $rs0
# CHECK-NEXT: $ad = PULSs
---
name: live_after
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $ad, $ix, $iy, $su, $rs2
    $rs0 = COPY killed $rs2
    RTSr implicit $ad, implicit $ix, implicit $iy, implicit $su, implicit $rs0
...
