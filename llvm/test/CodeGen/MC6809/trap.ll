; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py
; RUN: llc -mtriple=mc6809 -O0 %s -o - | FileCheck %s --check-prefix=O0
; RUN: llc -mtriple=mc6809 -O2 %s -o - | FileCheck %s --check-prefix=O2

; The 6809 has no trap instruction to spare, so llvm.trap, llvm.debugtrap
; and llvm.ubsantrap (-ftrapv, -fsanitize-trap) all become a call of
; abort(); the sanitizer check code is dropped.

declare void @llvm.trap()
declare void @llvm.debugtrap()
declare void @llvm.ubsantrap(i8)

define void @trap() {
; O0-LABEL: trap:
; O0:       ; %bb.0:
; O0-NEXT:    lbsr abort
;
; O2-LABEL: trap:
; O2:       ; %bb.0:
; O2-NEXT:    lbsr abort
  call void @llvm.trap()
  unreachable
}

define void @debugtrap() {
; O0-LABEL: debugtrap:
; O0:       ; %bb.0:
; O0-NEXT:    lbsr abort
; O0-NEXT:    rts
;
; O2-LABEL: debugtrap:
; O2:       ; %bb.0:
; O2-NEXT:    lbsr abort
; O2-NEXT:    rts
  call void @llvm.debugtrap()
  ret void
}

define void @ubsantrap() {
; O0-LABEL: ubsantrap:
; O0:       ; %bb.0:
; O0-NEXT:    lbsr abort
;
; O2-LABEL: ubsantrap:
; O2:       ; %bb.0:
; O2-NEXT:    lbsr abort
  call void @llvm.ubsantrap(i8 21)
  unreachable
}
