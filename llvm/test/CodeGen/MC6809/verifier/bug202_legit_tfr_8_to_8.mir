# RUN: llc -mtriple=mc6809 -mcpu=hd6309 -run-pass=none \
# RUN:   -verify-machineinstrs %s -o - 2>&1 | FileCheck %s

# Bug #202 negative sentinel: TFRp $aa, $ab is a legitimate 8-bit copy
# (size-matched, distinct registers). Must NOT trigger the verifier's
# size-mismatch check.

# CHECK-LABEL: name: legit_tfr_a_to_b
# CHECK: TFRp $aa
# CHECK-NOT: Bad machine code

---
name: legit_tfr_a_to_b
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $aa
    $ab = TFRp $aa
    RTSr
...
