# RUN: not --crash llc -mtriple=mc6809 -mcpu=hd6309 -run-pass=none \
# RUN:   -verify-machineinstrs %s -o /dev/null 2>&1 | FileCheck %s

# Bug #202: CMPRp $ad, $ad is degenerate (`cmpr D, D` always Z=1, N/V/C=0).
# This was the canonical signature of round 17 (commit 0b00909dd3b4) when
# raw SPILL_* operands defaulted to postbyte 0x00. The verifier must flag
# it.
#
# CMPRp operand layout differs from arithmetic siblings: no def output
# (only flag clobbers); operand 0 = $reg1 (use), operand 1 = $reg2 (use).

# CHECK: Bad machine code: HD6309 CMPR with degenerate same-reg postbyte
# CHECK: CMPRp

---
name: bad_cmpr_d_d
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $ad
    CMPRp $ad, $ad, implicit-def $nz, implicit-def $n, implicit-def $z, implicit-def $v
    RTSr
...
