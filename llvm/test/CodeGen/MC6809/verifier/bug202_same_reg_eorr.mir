# RUN: not --crash llc -mtriple=mc6809 -mcpu=hd6309 -run-pass=none \
# RUN:   -verify-machineinstrs %s -o /dev/null 2>&1 | FileCheck %s

# Bug #202: EORRp $ad, $ad is degenerate (`eorr D, D` always = 0).
# This is a clear-via-XOR shape; if it appears in MIR it's almost
# certainly a bug — clear-D should lower to LDD #0 / CLRA+CLRB. The
# verifier flags the same-reg form.

# CHECK: Bad machine code: HD6309 non-commutative reg-reg op with degenerate same-reg postbyte
# CHECK: EORRp

---
name: bad_eorr_d_d
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $ad
    $ad = EORRp $ad, $ad, implicit-def $nz, implicit-def $n, implicit-def $z, implicit-def $v
    RTSr
...
