# RUN: llc -mtriple=mc6809 -mcpu=hd6309 -run-pass=postrapseudos \
# RUN:   -verify-machineinstrs %s -o - 2>&1 | FileCheck %s

# Round-trip: a fused CompareBranch_i16_Imm with cc=NE (6) should expand
# to Compare_i16_Imm + Bbc_OnlyZ (short; branch relaxation widens it when
# needed, and the picker selects the OnlyZ variant because cc=NE reads
# only Z). Verifier must stay clean.

# CHECK-LABEL: name: cc_ne_picks_lblbc_no_c
# CHECK-NOT: undefined physical register
# CHECK-NOT: Bad machine code
# CHECK: Bbc_OnlyZ

---
name: cc_ne_picks_lblbc_no_c
tracksRegLiveness: true
body: |
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $ad
    CompareBranch_i16_Imm 6, $ad, 1, %bb.1, implicit-def $nz, implicit-def $v, implicit-def $c
    LongBranchRelative %bb.2

  bb.1:
    liveins: $ad
    RTSr

  bb.2:
    liveins: $ad
    RTSr
...
