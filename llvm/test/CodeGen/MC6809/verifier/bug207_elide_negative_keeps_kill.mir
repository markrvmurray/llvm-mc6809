# RUN: llc -mtriple=mc6809 -mcpu=hd6309 -O2 -run-pass=mc6809-final-lowering \
# RUN:   -mc6809-fl-store-reload-min-O=0 \
# RUN:   -verify-machineinstrs %s -o - 2>&1 | FileCheck %s

# Bug #207 negative sentinel: when there's NO redundant LDY to elide
# (because an intervening unrelated def of $iy invalidates the slot
# tracking), the kill flag on the STY must remain intact.

# CHECK-LABEL: name: elide_negative_keeps_kill
# CHECK-NOT: undefined physical register
# CHECK-NOT: Bad machine code
# Kill flag on STY's $iy use is preserved (no elision happened):
# CHECK: STYi_o8 16, $su, implicit killed $iy

---
name: elide_negative_keeps_kill
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $su, $iy
    LDYi_o8 18, $su, implicit-def $iy, implicit-def $nz, implicit-def $n, implicit-def $z, implicit-def $v
    STYi_o8 16, $su, implicit killed $iy, implicit-def $nz, implicit-def $n, implicit-def $z, implicit-def $v
    ; Independent reload from a DIFFERENT slot — slot tracking
    ; for offset 16 stays, but no LDY @ 16 to elide. Kill flag
    ; on the STY above must be preserved.
    LDYi_o8 20, $su, implicit-def $iy, implicit-def $nz, implicit-def $n, implicit-def $z, implicit-def $v
    nuw nusw inbounds LEAYi_o5 3, killed $iy, implicit-def $iy, implicit-def $nz, implicit-def $n, implicit-def $z, implicit-def $v
    STYi_o0 $iy, implicit killed $iy, implicit-def $nz, implicit-def $n, implicit-def $z, implicit-def $v
    RTSr
...
