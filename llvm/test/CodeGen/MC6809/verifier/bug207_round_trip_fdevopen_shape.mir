# RUN: llc -mtriple=mc6809 -mcpu=hd6309 -O2 -run-pass=mc6809-final-lowering \
# RUN:   -mc6809-fl-store-reload-min-O=0 \
# RUN:   -verify-machineinstrs %s -o - 2>&1 | FileCheck %s

# Bug #207 round-trip: the actual fdevopen bb.11 shape — TWO
# duplicate LDY @ 16 reloads in a row, both elided. The kill flag
# on the matching STY must be cleared, and the LEAY chain must
# verify clean.
#
# This is the verbatim picolibc/libc/stdio/fdevopen.c bb.11 pattern
# that triggered the original bug #207.

# CHECK-LABEL: name: round_trip_fdevopen_shape
# CHECK-NOT: undefined physical register
# CHECK-NOT: Bad machine code
# Both duplicate LDY @ 16 reloads gone:
# CHECK: LDYi_o8 18, $su, implicit-def $iy
# CHECK-NEXT: STYi_o8 16, $su, implicit $iy
# CHECK-NEXT: LEAYi_o5 3, killed $iy

---
name: round_trip_fdevopen_shape
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $su, $iy
    LDYi_o8 18, $su, implicit-def $iy, implicit-def $nz, implicit-def $n, implicit-def $z, implicit-def $v
    STYi_o8 16, $su, implicit killed $iy, implicit-def $nz, implicit-def $n, implicit-def $z, implicit-def $v
    LDYi_o8 16, $su, implicit-def $iy, implicit-def $nz, implicit-def $n, implicit-def $z, implicit-def $v
    LDYi_o8 16, $su, implicit-def $iy, implicit-def $nz, implicit-def $n, implicit-def $z, implicit-def $v
    nuw nusw inbounds LEAYi_o5 3, killed $iy, implicit-def $iy, implicit-def $nz, implicit-def $n, implicit-def $z, implicit-def $v
    STYi_o8 16, $su, implicit killed $iy, implicit-def $nz, implicit-def $n, implicit-def $z, implicit-def $v
    RTSr
...
