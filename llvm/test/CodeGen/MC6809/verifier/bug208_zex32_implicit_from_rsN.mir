# RUN: llc -mtriple=mc6809 -mcpu=hd6309 -run-pass=postrapseudos \
# RUN:     -verify-machineinstrs %s -o - 2>&1 | FileCheck %s

# Bug #208: ZEX32Implicit's post-RA expansion previously only handled
# the case where the i16 source ended up in $ad (TFR D,W; CLRDa).
# Sources in the imaginary direct-page registers $rs0..$rs3 — which
# regalloc places freely under HD6309 codegen pressure (notably in
# strtol's parsing accumulator) — were left without an AW load: the
# CLRDa fired against whatever stale $aw contents the prior codegen
# left, silently corrupting the low half of the resulting i32 in $aq.
#
# Fix: route every non-AW source through copyPhysReg (which already
# knows the right sequence for AD, RSn, and any future ACC16 member
# that survives MaterializeSpills) before CLRDa zeros AD.

# CHECK-LABEL: name: zex32_from_rs0
# Source in $rs0 → expansion must materialize $aw before CLRDa.
# copyPhysReg's Imag16→AW branch loads the direct-page slot straight into
# $aw with LDWd (HD6309): no $ad transit, so no TFRp and no pshs/puls to
# preserve $ad (which CLRDa would clobber next anyway).
# CHECK:      LDWd $rs0
# CHECK-NEXT: CLRDa
# CHECK-NOT:  ZEX32Implicit
---
name: zex32_from_rs0
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $rs0
    $aq = ZEX32Implicit $rs0, implicit-def $nz, implicit-def $v, implicit-def $c, implicit-def $ad, implicit-def $aw
    RTSr implicit $aq
...

# CHECK-LABEL: name: zex32_from_rs2
# Same shape as above with a different RSn source — confirms the fix
# does not depend on the specific imaginary register chosen.
# CHECK:      LDWd $rs2
# CHECK-NEXT: CLRDa
# CHECK-NOT:  ZEX32Implicit
---
name: zex32_from_rs2
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $rs2
    $aq = ZEX32Implicit $rs2, implicit-def $nz, implicit-def $v, implicit-def $c, implicit-def $ad, implicit-def $aw
    RTSr implicit $aq
...

# CHECK-LABEL: name: zex32_from_ad
# Source in $ad — pre-existing path; copyPhysReg's ACC16↔ACC16 branch
# emits a single TFRp $aw,$ad. No spurious LDD must appear (would
# imply the fix mishandled the AD-already-resident case).
# CHECK:      $aw = TFRp $ad
# CHECK-NEXT: CLRDa
# CHECK-NOT:  LDDd
# CHECK-NOT:  ZEX32Implicit
---
name: zex32_from_ad
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $ad
    $aq = ZEX32Implicit $ad, implicit-def $nz, implicit-def $v, implicit-def $c, implicit-def $ad, implicit-def $aw
    RTSr implicit $aq
...

# CHECK-LABEL: name: zex32_from_aw
# Source already in $aw — expansion must reduce to a single CLRDa
# (no copy needed; the early-out skips copyPhysReg entirely).
# CHECK:      CLRDa
# CHECK-NOT:  TFRp
# CHECK-NOT:  LDDd
# CHECK-NOT:  ZEX32Implicit
---
name: zex32_from_aw
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $aw
    $aq = ZEX32Implicit $aw, implicit-def $nz, implicit-def $v, implicit-def $c, implicit-def $ad, implicit-def $aw
    RTSr implicit $aq
...
