# RUN: llc -mtriple=mc6809 -mcpu=hd6309 -run-pass=postrapseudos \
# RUN:     %s -o - 2>&1 | FileCheck %s

# Bug #208 round 2: ZEX32Implicit's expansion previously emitted only
# CLRDa (zeroing AD, leaving AW = src) and removed its destination
# operand. When regalloc allocated the destination to a SPILL_Q* slot
# instead of the AQ physreg, the spill slot was never written and
# downstream EXTRACT_HI_word_i32 / byte-add consumers read uninitialised
# stack memory. The strtol miscompile that surfaced this: the digit's
# i16 value was zext'd to i32 in $spill_q0, then the byte-add chain in
# `acc * base + digit` consumed bytes 2/3 from the never-stored slot,
# corrupting the accumulator with stack garbage.
#
# Fix: capture DstReg before clearing AQ, then if DstReg != AQ, call
# dematerializeReg(AQ -> DstReg) which knows the right STQ sequence
# for SPILL_Q* and any other ACC32 spill target.

# CHECK-LABEL: name: zex32_to_spillq
# Source in $aw (no copy needed) → CLRDa → STQi to spill slot.
# CHECK:     CLRDa
# CHECK:     STQi{{.*}}implicit $aq
# CHECK-NOT: ZEX32Implicit

---
name: zex32_to_spillq
tracksRegLiveness: true
stack:
  - { id: 0, name: '', type: default, offset: -4, size: 4, alignment: 1,
      stack-id: default, callee-saved-register: '', callee-saved-restored: true,
      debug-info-variable: '', debug-info-expression: '', debug-info-location: '' }
body: |
  bb.0:
    liveins: $aw
    $spill_q0 = ZEX32Implicit $aw, implicit-def $nz, implicit-def $v, implicit-def $c, implicit-def $ad, implicit-def $aw
    RTSr
...

# CHECK-LABEL: name: zex32_to_aq
# Source in $aw, dst is $aq directly → just CLRDa, no STQ needed.
# CHECK:     CLRDa
# CHECK-NOT: STQi
# CHECK-NOT: ZEX32Implicit

---
name: zex32_to_aq
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $aw
    $aq = ZEX32Implicit $aw, implicit-def $nz, implicit-def $v, implicit-def $c, implicit-def $ad, implicit-def $aw
    RTSr implicit $aq
...
