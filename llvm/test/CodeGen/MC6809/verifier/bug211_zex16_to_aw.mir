# RUN: llc -mtriple=mc6809 -mcpu=hd6309 -run-pass=postrapseudos \
# RUN:     -verify-machineinstrs %s -o - 2>&1 | FileCheck %s

# Bug #211 (and the HD6309 leg of bug #209), re-expressed for the physreg-$ad
# ZEX16Implicit form (2026-06-28).
#
# OLD model: ZEX16Implicit had a vreg dst (ACC16). On HD6309 ACC16 includes AW,
# so regalloc could place the dst in AW; the expansion had to follow CLRA with a
# TFR D,W or the result was lost (the Bug #211 corruption in getopt_internal).
# That vreg-dst + implicit-AD form ALSO self-interfered with greedy (the AD def
# vetoed assigning the dst to AD -> $spill_d0 -> MaterializeSpills stack churn on
# a[i]).
#
# NEW model: ZEX16Implicit produces the result in PHYSICAL $ad (Uses=[AB],
# Defs=[..,$ad]) and selection appends `%dst = COPY $ad`. The expansion is now
# just CLRA. The AW-destination case (Bug #211) is handled by that COPY lowering
# to TFR D,W -- it is no longer the expansion's concern, so there is no dst
# variation here. Runtime coverage for the AW path: 6309 test-memmem / getopt at
# -Oz (the original #211 repro). This test just pins the (trivial) expansion and
# that it is verifier-clean in the physreg form.

# CHECK-LABEL: name: zex16_implicit_expand
# CHECK:      CLRAa
# CHECK-NOT:  ZEX16Implicit
# CHECK-NOT:  TFRp
---
name: zex16_implicit_expand
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $ab
    ZEX16Implicit implicit $ab, implicit-def $ad, implicit-def dead $nz, implicit-def dead $v, implicit-def dead $c
    RTSr implicit $ad
...
