# RUN: llc -mtriple=mc6809 -mcpu=hd6309 -run-pass=mc6809-materialize-spills \
# RUN:   %s -o - 2>&1 | FileCheck %s

# Bug #256 NEGATIVE sentinel: when the pre-MI $ab value is NOT the
# regalloc-dead garbage pattern (no upstream SpillLoad_i32_Mem +
# FAKE_USE killed sequence), MaterializeSpills' Bug #89 save/restore
# must STILL fire — the live $ab is a real upstream value that the
# downstream consumer wants preserved across the COPY's scratch use.
#
# This case differs from bug256_same_half_spill_copy_skip.mir in
# that $ab is live-in from a predecessor block (a legitimate live
# value), not from an upstream wide-acc-spill load followed by
# FAKE_USE-killed.  Skipping the wrap here would lose the live value.

# CHECK-LABEL: name: same_half_spill_copy_real_value_preserved
# The Bug #89 save/restore around the COPY MUST be emitted: pre-MI
# Store_i8_Mem $ab → temp slot, materialisation, post-MI
# Load_i8_Mem $ab ← temp slot.
# CHECK: Store_i8_Mem $ab
# CHECK-NEXT: $ab = Load_i8_Mem
# CHECK-NEXT: $ab = COPY
# CHECK-NEXT: Store_i8_Mem $ab
# CHECK-NEXT: $ab = Load_i8_Mem
# CHECK-NEXT: TestBranch

---
name: same_half_spill_copy_real_value_preserved
tracksRegLiveness: true
stack: []
body: |
  bb.0:
    successors: %bb.1, %bb.2
    ; $ab live-in carries a legitimate upstream value — no SpillLoad
    ; + FAKE_USE killed pattern preceding the COPY in this MBB.  The
    ; Bug #89 path's save/restore is needed to preserve $ab across
    ; the COPY's scratch use.
    liveins: $ab, $spill_b2

    renamable $spill_b1 = COPY killed renamable $spill_b2
    TestBranch_i8_Reg 6, killed renamable $ab, %bb.1, implicit-def dead $nz, implicit-def dead $v, implicit-def dead $c

  bb.1:
    RTSr

  bb.2:
    RTSr
...
