# RUN: llc -mtriple=mc6809 -mcpu=hd6309 -run-pass=mc6809-materialize-spills \
# RUN:   %s -o - 2>&1 | FileCheck %s

# Bug #256 partial fix: MaterializeSpills' Bug #89 save/restore around
# a same-half SPILL→SPILL COPY ($spill_b1 = COPY $spill_b2 here) was
# preserving the pre-MI $ab value across the COPY's materialisation.
# But the pre-MI $ab is REGALLOC-DEAD garbage — it came from an
# upstream SpillLoad_i32_Mem implicit-def whose super-register $aq /
# $spill_q* was subsequently killed by a FAKE_USE (the
# -fextend-lifetimes pattern emitted at -Og).
#
# The save/restore wrap PROPAGATES the garbage past the COPY,
# overwriting the materialisation's freshly-loaded byte (the value
# the next consumer actually wants).  Fix: detect this exact pattern
# in MC6809MaterializeSpills and skip the NeedSaveA / NeedSaveB save
# of the byte half for the COPY.
#
# This sentinel asserts that for the canonical garbage pattern the
# pass does NOT emit a pre-MI Store_i8_Mem $ab → temp / post-MI
# Load_i8_Mem $ab ← temp save/restore pair around the COPY.  The
# materialisation itself ($ab = LDB src-slot; STB dst-slot, $ab) is
# the only $ab traffic.

# CHECK-LABEL: name: same_half_spill_copy_garbage_skip
# Materialisation pattern: load from $spill_b2's slot into $ab, then
# (intermediate $ab = COPY $ab from same-class spill-rewrite), then
# store $ab to $spill_b1's slot.  No surrounding Store_i8_Mem $ab to
# temp / Load_i8_Mem $ab from temp wrap.
# CHECK: SpillLoad_i32_Mem
# CHECK-NEXT: FAKE_USE
# CHECK-NEXT: Load_i8_Imm 1
# CHECK-NEXT: $ab = Load_i8_Mem
# CHECK-NEXT: $ab = COPY
# CHECK-NEXT: Store_i8_Mem $ab
# CHECK-NEXT: TestBranch

---
name: same_half_spill_copy_garbage_skip
tracksRegLiveness: true
stack:
  - { id: 0, size: 4, alignment: 1 }   # SpillLoad source slot (i32)
body: |
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $ix, $spill_b2

    ; Canonical Bug #256 shape: SpillLoad_i32_Mem implicit-defs $ab.
    ; FAKE_USE killed $spill_q0 tells regalloc the wide value is
    ; dead, but $ab's bits linger in the physical register.
    ; TestBranch downstream reads $ab — the regalloc tracked $ab as
    ; "live" through LPR, but the live value IS garbage.
    renamable $spill_q0 = SpillLoad_i32_Mem %stack.0, 0, implicit-def $nz, implicit-def $v, implicit-def $aa, implicit-def $ab, implicit-def $ae, implicit-def $af, implicit-def $ad, implicit-def $aw :: (load (s32) from %stack.0, align 1)
    FAKE_USE killed renamable $spill_q0
    renamable $aa = Load_i8_Imm 1, implicit-def dead $nz, implicit-def dead $v
    renamable $spill_b1 = COPY killed renamable $spill_b2
    TestBranch_i8_Reg 6, killed renamable $ab, %bb.1, implicit-def dead $nz, implicit-def dead $v, implicit-def dead $c

  bb.1:
    RTSr

  bb.2:
    RTSr
...
