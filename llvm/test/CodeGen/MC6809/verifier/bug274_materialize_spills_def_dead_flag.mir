# RUN: llc -mtriple=mc6809 -mcpu=hd6309 -run-pass=mc6809-materialize-spills \
# RUN:   -verify-machineinstrs %s -o - 2>&1 | FileCheck %s

# Bug #274 (Og hit at picolibc test/libc-testsuite/phantom-bit1.c probe_phi):
# MC6809MaterializeSpills.cpp's DEF-spillback loop emits a Store_i8_Mem
# AFTER the MI when the rewritten DEF lands in $aa/$ab and the spill
# slot is a static stack slot. The Store reads the def — but the
# original spill-class DEF was often `dead` (no later same-MBB consumer
# beyond the spill-store itself), and that flag was inherited onto the
# rewritten DEF.  -verify-machineinstrs then flagged the Store_i8_Mem's
# use as "Using an undefined physical register".
#
# Fix: clear MO.setIsDead(false) on the rewritten DEF before emitting
# the Store_i8_Mem.  The store IS a live consumer.
#
# Repro: EXTRACT_LO_i16 producing into $spill_b0 with `dead` flag,
# fed from $ad. Stack slot 0 is the spill slot for $spill_b0.

# CHECK-LABEL: name: spillback_def_dead_flag
# CHECK-NOT: undefined physical register
# CHECK-NOT: Bad machine code

---
name: spillback_def_dead_flag
tracksRegLiveness: true
stack:
  - { id: 0, size: 2, alignment: 1 }
body: |
  bb.0:
    liveins: $ad

    ; Pre-fix MIR: `dead renamable $spill_b0 = EXTRACT_LO_i16 $ad`.
    ; MaterializeSpills rewrites $spill_b0 → $ab and emits
    ; Store_i8_Mem $ab → stack.0+1 after this MI.  Without the fix
    ; the rewritten $ab DEF stays `dead`, and the store reads a
    ; dead-def'd register.
    dead renamable $spill_b0 = EXTRACT_LO_i16 renamable $ad, implicit-def dead $nz, implicit-def dead $v
    RTSr
...
