# RUN: llc -mtriple=mc6809 -mcpu=hd6309 -run-pass=postrapseudos \
# RUN:     -verify-machineinstrs %s -o - 2>&1 | FileCheck %s

# Bug #285 (closed 2026-05-12): emitSpillStore was missing an
# implicit-def of the imaginary SPILL_* register being written.
#
# When a post-RA pseudo's destination is a SPILL_* slot (regalloc's
# choice for a high-pressure ACC32/ACC16/ACC8 result) and the pseudo's
# expansion calls dematerializeReg() to store the real-reg value to
# the slot, the originating pseudo MI is erased and replaced by an
# ST{Q,D,A,B,X,Y}i_o{8,16} memory store. The store correctly carries
# an implicit USE of the real-reg holding the value — but had NO
# def-operand for the imaginary SPILL_* register. Liveness analysis
# treated the SPILL_* as never defined post-expansion.
#
# Harmless until -fextend-lifetimes emits FAKE_USE on the SPILL_*
# (the FAKE_USE travels with the source variable's vreg, which
# regalloc may have assigned to a spill slot). Manifest at
# Og-hd6309-mame on picolibc hash_buf.c `__get_buf`, after Bug #284's
# wider ZEX32Implicit Defs caused regalloc to prefer $spill_q0 over
# $aq for the i32 dst of a `zext i16 to i32` value.
#
# Failure mode pre-fix:
#   *** Bad machine code: Using an undefined physical register ***
#   - instruction: FAKE_USE killed renamable $spill_q0
#
# Fix: emitSpillStore adds .addReg(SpillReg, RegState::ImplicitDefine)
# so the spill-slot store also defines the SPILL_* in the regalloc /
# liveness model. -verify-machineinstrs then accepts the FAKE_USE.

# CHECK-LABEL: name: zex32_to_spillq_with_fake_use
# CHECK:     CLRDa
# CHECK:     STQi{{.*}}implicit $aq{{.*}}implicit-def $spill_q0
# CHECK:     FAKE_USE killed renamable $spill_q0
# CHECK-NOT: Bad machine code

---
name: zex32_to_spillq_with_fake_use
tracksRegLiveness: true
stack:
  - { id: 0, name: '', type: default, offset: -4, size: 4, alignment: 1,
      stack-id: default, callee-saved-register: '', callee-saved-restored: true,
      debug-info-variable: '', debug-info-expression: '', debug-info-location: '' }
body: |
  bb.0:
    liveins: $aw
    $spill_q0 = ZEX32Implicit $aw, implicit-def $nz, implicit-def $v, implicit-def $c, implicit-def $ad, implicit-def $aw
    FAKE_USE killed renamable $spill_q0
    RTSr
...
