# RUN: llc -mtriple=mc6809 -mcpu=hd6309 -run-pass=postrapseudos \
# RUN:     -verify-machineinstrs %s -o - 2>&1 | FileCheck %s

# Bug #298 (2026-05-15): expandAddSub_i32_Reg allocated its emergency
# 4-byte spill slot via `MFI.CreateStackObject` + `getObjectOffset`.
# Because expandPostRAPseudo runs AFTER PEI, the freshly-created stack
# object never gets laid out — `getObjectOffset` returns 0.  An
# emergency-slot offset of 0 from U collides with the pshs-saved Y/U
# area at the head of every function with a `pshs y,u; tfr s,u`
# prologue (saved Y at [U+0..U+1], saved U at [U+2..U+3]).
#
# The `stq ,u` (offset 0 from U) wrote the i32 operand value over
# the saved registers.  When the function's epilogue did `puls y,u`,
# it restored garbage instead of the caller's frame pointer.
#
# Manifest: picolibc `muld_neg60_probe` at Os-lto-hd6309-mame hung
# (timed out at 5 sec) because vfprintf's saved Y/U slot got
# overwritten with the i32 value -1740 ($ffff_f934) during `%d`
# processing of the `printf("%d\n", -1740)` call site.  vfprintf's
# `puls y,u` then restored Y=$ffff, U=$f934; printf's `tfr u,s` set
# S=$f934; the subsequent `puls y,u; leas $a,s; rts` chain popped
# zero return PCs from uninitialized stack — PC became $0000 and the
# CPU executed `NEG <$00` through low memory, eventually wrecking
# .text and hanging.
#
# Fix: replace the broken `CreateStackObject` mechanism with a
# transient `LEAS -4,S` + `STQ ,S` pair at the start of the
# expansion, and `LEAS 4,S` at the end.  The emergency slot lives at
# [S+0..S+3] (S-relative) for the duration of the expansion; the
# materialize/dematerialize uses U-relative addressing which is
# stable across S-manipulations.

# src in $spill_q0, src2 in $aq.  Sub_i32_Reg expansion must:
#   - allocate the emergency slot via `LEAS -4, $ss` at entry
#   - save AQ to [S+0..S+3] via `STQ ,$ss`
#   - materialize $spill_q0 into $aq (LDQ from $su)
#   - subtract emergency low/high halves (SUBW $2,$ss; SBCD ,$ss)
#   - dematerialize $aq back to $spill_q0 (STQ to $su)
#   - release the emergency slot via `LEAS 4, $ss` before exit
#
# The bug was an `STQi_o0 ... $su` for the emergency save (offset 0
# from U).  After the fix, the emergency save must use $ss, never $su.

# CHECK-LABEL: name: sub_i32_reg_emergency_slot
# Allocate 4 bytes on the hard stack.
# CHECK:     LEASi_o5 -4, $ss
# Save AQ to emergency at [S+0..3].
# CHECK:     STQi_o0
# CHECK-SAME: $ss
# Materialize $spill_q0 into $aq via LDQ from $su.
# CHECK:     LDQi
# CHECK-SAME: $su
# Subtract emergency-stored value from $aq.  Low half at S+2, high at S+0.
# CHECK:     SUBW
# CHECK-SAME: $ss
# CHECK:     SBCD
# CHECK-SAME: $ss
# Dematerialize $aq back to $spill_q0.
# CHECK:     STQi
# CHECK-SAME: $su
# Release emergency slot.
# CHECK:     LEASi_o5 4, $ss

# Critical check: the original bug was an `STQ ,U` (offset 0 from U)
# for the emergency save.  After the fix, the emergency MUST be on $ss
# never $su.  Other STQ-to-$su instructions exist (the dematerialize
# spill store), so the negative check needs to match the BUG shape
# specifically: STQi_o0 (zero-offset) targeting $su as an emergency
# save.  This is most easily checked at the SAVE site (instruction
# adjacent to LEAS -4,$ss).
# CHECK-NOT: STQi_o0 implicit $aq, $su

---
name: sub_i32_reg_emergency_slot
tracksRegLiveness: true
stack:
  - { id: 0, name: '', type: default, offset: -4, size: 4, alignment: 1,
      stack-id: default, callee-saved-register: '', callee-saved-restored: true,
      debug-info-variable: '', debug-info-expression: '', debug-info-location: '' }
body: |
  bb.0:
    liveins: $aq, $spill_q0
    renamable $spill_q0 = Sub_i32_Reg renamable $spill_q0, renamable $aq, implicit-def $nz, implicit-def $v, implicit-def $c
    RTSr
...
