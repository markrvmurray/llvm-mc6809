# RUN: llc -mtriple=mc6809 -mcpu=hd6309 -run-pass=postrapseudos \
# RUN:     -verify-machineinstrs %s -o - 2>&1 | FileCheck %s

# Bug #305 part 2 cluster A (2026-05-18): Build32_i16i16 with a
# SPILL_Q*N destination expands into two STD instructions writing
# slot+0 and slot+2.  The source MI's explicit OutOperand
# (`$spill_q*`) is the only visible def of that imaginary register
# in the MIR.  Erasing the MI without re-attaching a marker leaves
# downstream `FAKE_USE renamable $spill_q*` (emitted by
# -fextend-lifetimes at -Og) reading an undefined physical register,
# which `-verify-machineinstrs` rejects with "Using an undefined
# physical register".
#
# Manifest: 3 hits at -Og-hd6309-mame (__log2 bb.3 for.end /
# __default_hash bb.6 while.end / __call_hash bb.3 if.end), all
# `FAKE_USE renamable $spill_q*` after Build32_i16i16 expanded.
#
# Fix: attach `implicit-def $spill_q*` to the last STD as the
# visible def.  Mirrors the AQ-dest path's `implicit-def $aq`
# fixup already in place (Bug #302 Phase 2 fixup 2026-05-17).

# CHECK-LABEL: name: build32_spillq_with_fakeuse
# The expansion emits two STDs and the last one must carry the
# implicit-def of the SPILL_Q* destination so FAKE_USE sees it
# defined.
# CHECK:     STDi
# CHECK:     STDi
# CHECK-SAME: implicit-def $spill_q0
# CHECK:     FAKE_USE renamable $spill_q0

---
name: build32_spillq_with_fakeuse
tracksRegLiveness: true
stack:
  - { id: 0, name: '', type: spill-slot, offset: 0, size: 4, alignment: 1,
      stack-id: default, callee-saved-register: '', callee-saved-restored: true,
      debug-info-variable: '', debug-info-expression: '', debug-info-location: '' }
body: |
  bb.0:
    liveins: $ad, $su
    renamable $spill_q0 = Build32_i16i16 killed renamable $ad, killed renamable $ad, implicit-def dead $nz, implicit-def dead $v, implicit-def dead $ad, implicit-def dead $aw
    FAKE_USE renamable $spill_q0
    RTSr
...
