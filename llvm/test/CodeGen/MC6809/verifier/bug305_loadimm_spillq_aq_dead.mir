# RUN: llc -mtriple=mc6809 -mcpu=hd6309 -run-pass=postrapseudos \
# RUN:     -verify-machineinstrs %s -o - 2>&1 | FileCheck %s

# Bug #305 (2026-05-18): expandLoadImm's SPILL_Q*N destination path
# unconditionally wrapped the LDQ#imm + STQ-to-slot body in
# `emitAQPreservedOverHardStackScratch` (Bug #300's fix), which emits
# `LEAS -4,$ss; STQ ,$ss; <body>; LDQ ,$ss; LEAS 4,$ss`.  The leading
# `STQ ,$ss` reads $aq to save its current value.  When $aq is dead
# at this expansion point (the common case after an LDD that legitimately
# killed $aq via Bug #299's AQ-in-Defs), the read is undefined and
# `-verify-machineinstrs` rejects it.
#
# Manifest: 61 STQi_o0 verifier hits at -Og-hd6309-mame, spread across
# main (54), __ubsan_val_to_string (2), strncmp / strstr / gmtime_r /
# _rs_init / __hash_open (1 each).  Same shape every time -- save-STQ
# of a dead $aq.
#
# Fix: probe $aq's liveness at the expansion site (LivePhysRegs walk
# from MBB.begin() to MI.iterator(), matching the pattern in
# expandStoreIdx's SrcIsImpliedUndef computation).  When $aq is dead,
# skip the save/restore entirely and emit the body directly.  When live,
# keep the Bug #300 wrapping intact (regalloc may legitimately place a
# vreg in $aq across this pseudo).

# Test 1: $aq dead at expansion -- must skip save/restore.
# CHECK-LABEL: name: loadimm_spillq_aq_dead
# Direct LDQ#imm and STQ-to-slot, no surrounding LEAS/STQ-save.
# CHECK:     LDQi32 305419896
# CHECK:     STQi
# CHECK-NOT: LEASi_o5 -4, $ss
# CHECK-NOT: STQi_o0 $ss

# Test 2: $aq live at expansion -- must keep save/restore.
# CHECK-LABEL: name: loadimm_spillq_aq_live
# CHECK:     LEASi_o5 -4, $ss
# CHECK:     STQi_o0
# CHECK-SAME: $ss
# CHECK:     LDQi32 305419896
# CHECK:     STQi
# CHECK:     LDQi_o0 $ss
# CHECK:     LEASi_o5 4, $ss

---
name: loadimm_spillq_aq_dead
tracksRegLiveness: true
stack:
  - { id: 0, name: '', type: spill-slot, offset: 0, size: 4, alignment: 1,
      stack-id: default, callee-saved-register: '', callee-saved-restored: true,
      debug-info-variable: '', debug-info-expression: '', debug-info-location: '' }
body: |
  bb.0:
    liveins: $su
    ; $aq NOT in liveins -- dead at the Load_i32_Imm site.
    renamable $spill_q0 = Load_i32_Imm 305419896, implicit-def $nz, implicit-def $v
    RTSr
...

---
name: loadimm_spillq_aq_live
tracksRegLiveness: true
stack:
  - { id: 0, name: '', type: spill-slot, offset: 0, size: 4, alignment: 1,
      stack-id: default, callee-saved-register: '', callee-saved-restored: true,
      debug-info-variable: '', debug-info-expression: '', debug-info-location: '' }
body: |
  bb.0:
    liveins: $aq, $su
    ; $aq IS in liveins -- save/restore required to preserve its value.
    renamable $spill_q0 = Load_i32_Imm 305419896, implicit-def $nz, implicit-def $v
    RTSr implicit $aq
...
