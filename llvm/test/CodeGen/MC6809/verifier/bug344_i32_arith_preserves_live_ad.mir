# RUN: llc -mtriple=mc6809 -mcpu=hd6309 -run-pass=mc6809-materialize-spills \
# RUN:   %s -o - 2>&1 | FileCheck %s
#
# Bug #344: an i32-register arithmetic pseudo (Sub_i32_Reg etc.) whose
# operands are spilled ($spill_q*) materialises them into the physical
# $aq (= $ad:$aw) as scratch to run SUBW/SBCD. That clobbers $ad — but
# the pseudo does NOT declare the AQ clobber (declaring it as Defs blows
# binary sizes, see feedback_addsub_i32_defs_not_extendable), so regalloc
# is free to keep a live i16 value in $ad across it. MaterializeSpills
# must therefore preserve a live $ad around such a Q-scratch clobber.
#
# Manifested as strtol returning a NEGATED positive value: the
# conditional negate `if (flags & FLAG_NEG) val = -val` keeps `flags&1`
# in $ad while Sub_i32_Reg(spilled) materialises -val into $aq, and the
# following TestBranch then read the clobbered $ad.
#
# The save must bracket the Sub: STD $ad before, LDD $ad after, so the
# TestBranch sees the original $ad. (Contrast bug256_same_half_spill_copy
# _skip.mir: a MI that DECLARES its AQ-subreg defs — e.g. SpillLoad — must
# NOT be wrapped, and FAKE_USE must never trigger a save.)

---
name:            sub_i32_spill_preserves_live_ad
tracksRegLiveness: true
stack:
  - { id: 0, size: 4, alignment: 1 }
body: |
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $ad, $spill_q0, $spill_q1

    ; CHECK-LABEL: name: sub_i32_spill_preserves_live_ad
    ; CHECK:      Store_i16_Mem $ad, %stack.{{[0-9]+}}, 0
    ; CHECK-NEXT: Sub_i32_Reg
    ; CHECK-NEXT: $ad = Load_i16_Mem %stack.{{[0-9]+}}, 0
    ; CHECK-NEXT: TestBranch_i16_Reg 7, killed renamable $ad
    renamable $spill_q0 = Sub_i32_Reg renamable $spill_q0, renamable $spill_q1, implicit-def dead $nz, implicit-def dead $v, implicit-def dead $c
    TestBranch_i16_Reg 7, killed renamable $ad, %bb.1, implicit-def dead $nz, implicit-def dead $v, implicit-def dead $c

  bb.1:
    RTSr

  bb.2:
    RTSr
...
